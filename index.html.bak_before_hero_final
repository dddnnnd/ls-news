  letter-spacing: 0.06em;
  font-size: 12px;
}
.san-rating-table td.row-label {
  color: #54acd2;
  font-weight: 800;
  letter-spacing: 0.05em;
  font-size: 12px;
  background: rgba(25, 28, 34, 0.65);
}
.san-rating-table .col-sfn { color: #00e676; }
.san-rating-table .col-lsn {
  color: #819bad;
  background: rgba(245, 158, 11, 0.10);
  position: relative;
}
.san-rating-table td.col-lsn-cell {
  background: rgba(245, 158, 11, 0.09);
  font-weight: 800;
  color: #ffffff;
}
.san-rating-table .col-lvn { color: #fe2c56; }
.san-award-bonus {
  display: block;
  margin-top: 4px;
  font-size: 11.5px;
  color: #6fe2be;
  font-weight: 700;
}
.san-award-warn {
  display: block;
  margin-top: 4px;
  font-size: 11.5px;
  color: #ef4444;
  font-weight: 700;
}
.san-rating-modal__footer {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.san-forum-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 18px;
  border-radius: 999px;
  background: linear-gradient(135deg, #f59e0b, #38bdf8);
  color: #061015;
  font-weight: 900;
  font-size: 13px;
  text-decoration: none;
  box-shadow: 0 6px 20px rgba(245, 158, 11, 0.35);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.san-forum-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 26px rgba(245, 158, 11, 0.45);
}

/* 10. Editorial Staff Roster Article & Interactive Editor (#lsn-staff) */
.lsn-staff-section {
  margin: 0 clamp(20px, 6vw, 90px) 76px;
  padding: clamp(28px, 4vw, 52px);
  border-radius: 26px;
  background:
    radial-gradient(circle at 12% 15%, rgba(245, 158, 11, 0.12), transparent 42%),
    radial-gradient(circle at 88% 85%, rgba(199, 255, 82, 0.06), transparent 45%),
    linear-gradient(165deg, #0d131c 0%, #090d14 100%);
  border: 1px solid rgba(245, 158, 11, 0.25);
  box-shadow: 0 28px 80px rgba(0, 0, 0, 0.65), 0 0 40px rgba(245, 158, 11, 0.09);
  position: relative;
  overflow: hidden;
}

.lsn-staff-section.is-editing {
  border-color: rgba(199, 255, 82, 0.55);
  box-shadow: 0 28px 80px rgba(0, 0, 0, 0.72), 0 0 45px rgba(199, 255, 82, 0.14);
}

.lsn-staff-topbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding-bottom: 24px;
  margin-bottom: 28px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.09);
}

.lsn-staff-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  border-radius: 999px;
  background: rgba(245, 158, 11, 0.14);
  border: 1px solid rgba(245, 158, 11, 0.32);
  color: var(--cyan);
  font: 800 11px/1 var(--font-mono);
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.lsn-staff-controls {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
}

.lsn-staff-btn {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 9px 16px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.05);
  color: #e2e8f0;
  font: 700 13px/1.1 var(--font-sans);
  cursor: pointer;
  transition: transform 0.18s ease, background 0.2s ease, border-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
}

.lsn-staff-btn:hover {
  transform: translateY(-1px);
  border-color: var(--cyan);
  background: rgba(245, 158, 11, 0.16);
  color: #ffffff;
}

.lsn-staff-btn--primary {
  background: rgba(199, 255, 82, 0.14);
  border-color: rgba(199, 255, 82, 0.45);
  color: var(--lime);
}

.lsn-staff-btn--primary:hover,
.lsn-staff-btn--primary[aria-pressed="true"] {
  background: var(--lime);
  border-color: var(--lime);
  color: #071004;
  box-shadow: 0 6px 22px rgba(199, 255, 82, 0.32);
}

.lsn-staff-btn--cyan {
  background: rgba(100, 232, 255, 0.13);
  border-color: rgba(245, 158, 11, 0.45);
  color: var(--cyan);
}

.lsn-staff-btn--cyan:hover {
  background: var(--cyan);
  border-color: var(--cyan);
  color: #041016;
  box-shadow: 0 6px 22px rgba(245, 158, 11, 0.35);
}

.lsn-staff-save-pill {
  font: 700 12px/1 var(--font-mono);
  color: var(--lime);
  padding: 6px 12px;
  border-radius: 999px;
  background: rgba(199, 255, 82, 0.1);
  border: 1px solid rgba(199, 255, 82, 0.28);
  opacity: 0;
  transform: translateY(4px);
  transition: opacity 0.25s ease, transform 0.25s ease;
  pointer-events: none;
}

.lsn-staff-save-pill.is-visible {
  opacity: 1;
  transform: translateY(0);
}

/* Editorial Article Intro inside #lsn-staff */
.lsn-staff-article {
  display: grid;
  grid-template-columns: 1.35fr 0.65fr;
  gap: 32px;
  align-items: start;
  margin-bottom: 36px;
  padding: 28px;
  border-radius: 20px;
  background: rgba(15, 22, 32, 0.78);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.lsn-staff-article__title {
  margin: 0 0 14px;
  font-family: var(--font-serif);
  font-size: clamp(26px, 3.3vw, 42px);
  line-height: 1.08;
  letter-spacing: -0.03em;
  font-weight: 900;
  color: #ffffff;
}

.lsn-staff-article__lead {
  margin: 0 0 14px;
  font-size: 17px;
  line-height: 1.6;
  color: #dbe7f3;
  font-weight: 600;
}

.lsn-staff-article__body {
  margin: 0;
  font-size: 15px;
  line-height: 1.7;
  color: #98a6b8;
  white-space: pre-line;
}

.lsn-staff-article__stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.lsn-staff-stat-box {
  padding: 16px 18px;
  border-radius: 16px;
  background: rgba(9, 13, 20, 0.85);
  border: 1px solid rgba(245, 158, 11, 0.22);
}

.lsn-staff-stat-box b {
  display: block;
  font-size: 24px;
  font-weight: 900;
  color: var(--cyan);
  letter-spacing: -0.03em;
  margin-bottom: 4px;
}

.lsn-staff-stat-box span {
  font-size: 12px;
  color: #94a3b8;
  line-height: 1.35;
  display: block;
}

.lsn-staff-edit-banner {
  margin-bottom: 24px;
  padding: 12px 18px;
  border-radius: 14px;
  background: rgba(199, 255, 82, 0.09);
  border: 1px dashed rgba(199, 255, 82, 0.48);
  color: #e2f8b0;
  font-size: 13.5px;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.lsn-staff-edit-banner[hidden] {
  display: none !important;
}

/* 4-Column Staff Roster Grid */
.lsn-staff-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(265px, 1fr));
  gap: 22px;
}

.lsn-staff-card {
  position: relative;
  display: flex;
  flex-direction: column;
  border-radius: 20px;
  overflow: hidden;
  background: linear-gradient(180deg, #151c27 0%, #0e131b 100%);
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
  transition: transform 0.28s var(--ease), border-color 0.25s ease, box-shadow 0.28s ease;
}

.lsn-staff-card:hover {
  transform: translateY(-5px);
  border-color: rgba(245, 158, 11, 0.45);
  box-shadow: 0 22px 54px rgba(0, 0, 0, 0.65), 0 0 28px rgba(245, 158, 11, 0.18);
}

.lsn-staff-card__media {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 4.4;
  background: #2f2822;
  overflow: hidden;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.lsn-staff-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  display: block;
  transition: transform 0.4s var(--ease);
}

.lsn-staff-card:hover .lsn-staff-card__img {
  transform: scale(1.03);
}

.lsn-staff-card__badges {
  position: absolute;
  top: 12px;
  left: 12px;
  right: 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  pointer-events: none;
}

.lsn-staff-rank-pill {
  padding: 4px 10px;
  border-radius: 999px;
  background: rgba(8, 12, 18, 0.86);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(245, 158, 11, 0.45);
  color: var(--cyan);
  font: 800 10.5px/1 var(--font-mono);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.lsn-staff-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: 999px;
  background: rgba(18, 15, 12, 0.86);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(217, 119, 6, 0.34);
  color: #ecd4b0;
  font: 700 10px/1 var(--font-mono);
  letter-spacing: 0.08em;
}

.lsn-staff-card__body {
  padding: 20px 20px 18px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.lsn-staff-card__dept {
  font: 800 10.5px/1.2 var(--font-mono);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--cyan);
  margin-bottom: 6px;
}

.lsn-staff-card__name {
  margin: 0 0 4px;
  font-family: var(--font-serif);
  font-size: 23px;
  font-weight: 900;
  letter-spacing: -0.02em;
  color: #ffffff;
  line-height: 1.15;
}

.lsn-staff-card__role {
  font-size: 13.5px;
  font-weight: 700;
  color: #ffd166;
  margin-bottom: 12px;
}

.lsn-staff-card__bio {
  margin: 0 0 18px;
  font-size: 14px;
  line-height: 1.6;
  color: #a3b1c2;
  flex: 1;
  white-space: pre-line;
}

/* Editable highlight when in Edit Mode */
.lsn-staff-section.is-editing [data-staff-editable="true"] {
  outline: 1px dashed rgba(199, 255, 82, 0.55);
  outline-offset: 4px;
  border-radius: 6px;
  background: rgba(199, 255, 82, 0.05);
  cursor: text;
  transition: background 0.15s ease, outline-color 0.15s ease;
}

.lsn-staff-section.is-editing [data-staff-editable="true"]:focus {
  outline: 2px solid var(--lime);
  background: rgba(199, 255, 82, 0.11);
  color: #ffffff;
}

.lsn-staff-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding-top: 14px;
  border-top: 1px solid rgba(255, 255, 255, 0.07);
}

.lsn-staff-card__edit-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 13px;
  border-radius: 999px;
  border: 1px solid rgba(245, 158, 11, 0.35);
  background: rgba(245, 158, 11, 0.12);
  color: var(--cyan);
  font: 700 12px/1 var(--font-sans);
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
}

.lsn-staff-card__edit-btn:hover {
  background: var(--cyan);
  border-color: var(--cyan);
  color: #051016;
}

.lsn-staff-card__del-btn {
  padding: 7px 11px;
  border-radius: 999px;
  border: 1px solid rgba(255, 82, 101, 0.3);
  background: rgba(255, 82, 101, 0.08);
  color: #ff8c9a;
  font: 700 12px/1 var(--font-sans);
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease;
}

.lsn-staff-card__del-btn:hover {
  background: var(--red);
  color: #ffffff;
}

/* Staff Member Edit Modal (#lsn-staff-edit-dialog) */
#lsn-staff-edit-dialog {
  width: min(620px, calc(100vw - 28px));
  border: 1px solid rgba(245, 158, 11, 0.40);
  border-radius: 22px;
  background: #121822;
  color: #f1f5f9;
  padding: 0;
  box-shadow: 0 36px 100px rgba(0, 0, 0, 0.85), 0 0 45px rgba(245, 158, 11, 0.18);
}

.lsn-staff-modal {
  padding: 26px 28px;
  max-height: 90vh;
  overflow-y: auto;
}

.lsn-staff-modal__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 18px;
}

.lsn-staff-modal__title {
  margin: 4px 0 0;
  font-family: var(--font-serif);
  font-size: 25px;
  font-weight: 900;
  color: #ffffff;
}

.lsn-staff-form {
  display: grid;
  gap: 14px;
}

.lsn-staff-form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.lsn-staff-form label {
  display: grid;
  gap: 6px;
  font-size: 12.5px;
  font-weight: 700;
  color: #cbd5e1;
}

.lsn-staff-form input[type="text"],
.lsn-staff-form textarea {
  width: 100%;
  padding: 10px 13px;
  border-radius: 10px;
  border: 1px solid rgba(255, 255, 255, 0.14);
  background: #090d14;
  color: #ffffff;
  font: 14px/1.45 var(--font-sans);
}

.lsn-staff-form textarea {
  min-height: 96px;
  resize: vertical;
}

.lsn-staff-form input:focus,
.lsn-staff-form textarea:focus {
  outline: 2px solid var(--cyan);
  border-color: transparent;
}

.lsn-skin-picker {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  margin-top: 4px;
}

.lsn-skin-option {
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  border: 2px solid rgba(255, 255, 255, 0.12);
  background: #2b241f;
  cursor: pointer;
  padding: 0;
  aspect-ratio: 3 / 3.4;
  transition: border-color 0.2s ease, transform 0.2s ease;
}

.lsn-skin-option img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
}

.lsn-skin-option.is-selected {
  border-color: var(--lime);
  box-shadow: 0 0 0 3px rgba(199, 255, 82, 0.25);
  transform: translateY(-2px);
}

.lsn-skin-option span {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(6, 10, 15, 0.85);
  color: #e2e8f0;
  font: 700 10px/1.4 var(--font-mono);
  text-align: center;
  padding: 3px 4px;
}

.lsn-staff-modal__actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 8px;
  padding-top: 14px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

@media (max-width: 920px) {
  .lsn-staff-article {
    grid-template-columns: 1fr;
  }
  .lsn-staff-form-row {
    grid-template-columns: 1fr;
  }
}

/* 11. Clickable Ad Slides, Rich Ad Reader Modal & Journalist Cabinet Ad Studio */
.lsn-ad-slide {
  cursor: pointer;
}

.lsn-ad-slide:hover .lsn-ad-slide__button {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(199, 255, 82, 0.38);
}

.lsn-ad-read-hint {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-left: 12px;
  font: 700 12px/1 var(--font-sans);
  color: var(--cyan);
  opacity: 0.85;
}

.lsn-ad-slide__art img.lsn-ad-custom-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Upgraded Ad Reader Dialog (#lsn-ad-dialog) */
#lsn-ad-dialog {
  width: min(780px, calc(100vw - 28px));
}

.lsn-ad-reader {
  max-height: 90vh;
  overflow-y: auto;
  padding: clamp(24px, 4vw, 40px);
  background: linear-gradient(165deg, #111823 0%, #0b0f17 100%);
  border: 1px solid rgba(245, 158, 11, 0.38);
  border-radius: 24px;
  box-shadow: 0 40px 120px rgba(0, 0, 0, 0.85), 0 0 50px rgba(245, 158, 11, 0.18);
}

.lsn-ad-reader__visual {
  width: 100%;
  height: 230px;
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: #0b1119;
  margin-bottom: 22px;
}

.lsn-ad-reader__visual svg,
.lsn-ad-reader__visual img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.lsn-ad-reader__lead {
  font-size: 17.5px !important;
  font-weight: 700;
  color: #e2e8f0 !important;
  line-height: 1.55 !important;
  margin: 0 0 16px !important;
}

.lsn-ad-reader__body {
  color: #b0becf;
  font-size: 15.5px;
  line-height: 1.75;
  white-space: pre-line;
  margin-bottom: 24px;
}

.lsn-ad-reader__footer {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding-top: 18px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.lsn-ad-reader__meta {
  font: 700 12.5px/1.4 var(--font-mono);
  color: var(--lime);
  background: rgba(199, 255, 82, 0.08);
  border: 1px solid rgba(199, 255, 82, 0.28);
  padding: 8px 14px;
  border-radius: 10px;
}

/* Wide Journalist Cabinet (#auth-dialog) */
.auth-dialog--wide {
  width: min(1040px, calc(100vw - 28px));
}

.auth-dialog--wide .auth-modal-card {
  max-height: 92vh;
  overflow-y: auto;
  padding: clamp(22px, 3.5vw, 36px);
}

.portal-panel[hidden] {
  display: none !important;
}

.cab-ads-layout {
  display: grid;
  grid-template-columns: 0.92fr 1.08fr;
  gap: 24px;
  align-items: start;
}

.cab-ads-list-col,
.cab-ads-form-col {
  background: rgba(9, 13, 20, 0.75);
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 18px;
  padding: 20px;
}

.cab-ads-col-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 16px;
  padding-bottom: 12px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.cab-ads-items {
  display: grid;
  gap: 12px;
  max-height: 440px;
  overflow-y: auto;
  padding-right: 4px;
}

.cab-ad-item {
  padding: 14px;
  border-radius: 14px;
  background: #121924;
  border: 1px solid rgba(255, 255, 255, 0.1);
  transition: border-color 0.2s ease, background 0.2s ease;
}

.cab-ad-item.is-editing {
  border-color: var(--cyan);
  background: rgba(245, 158, 11, 0.10);
}

.cab-ad-item__tag {
  font: 800 10px/1 var(--font-mono);
  letter-spacing: 0.14em;
  color: var(--cyan);
  text-transform: uppercase;
  margin-bottom: 5px;
}

.cab-ad-item__title {
  font-weight: 800;
  font-size: 15.5px;
  color: #ffffff;
  margin: 0 0 6px;
}

.cab-ad-item__short {
  font-size: 12.5px;
  color: #94a3b8;
  margin: 0 0 12px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.cab-ad-item__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

/* Color Picker & Swatches for Articles, Ads & Columns */
.uni-extra-box {
  display: grid;
  gap: 8px;
  padding: 12px 14px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  margin-top: 4px;
}
.uni-color-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
}
.uni-color-swatch {
  width: 24px;
  height: 24px;
  min-width: 24px;
  min-height: 24px;
  border-radius: 50%;
  border: 2px solid rgba(255, 255, 255, 0.35);
  cursor: pointer;
  padding: 0;
  display: inline-block;
  vertical-align: middle;
  outline: none;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease, box-shadow 0.2s ease;
}
.uni-color-swatch:hover {
  transform: scale(1.2);
  border-color: #ffffff;
  box-shadow: 0 0 10px rgba(245, 158, 11, 0.5);
}
.uni-color-swatch.is-selected {
  transform: scale(1.25);
  border-color: #fbbf24;
  box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.4), 0 3px 10px rgba(0, 0, 0, 0.7);
}
.uni-color-custom {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font: 700 12.5px/1 var(--font-sans);
