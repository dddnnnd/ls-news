      cam.y += dy * 0.18;
      cam.w += dw * 0.18;
      cam.h += dh * 0.18;
      rafId = window.requestAnimationFrame(renderCamera);
    }
    panorama.setAttribute('viewBox', `${cam.x.toFixed(1)} ${cam.y.toFixed(1)} ${cam.w.toFixed(1)} ${cam.h.toFixed(1)}`);
  };

  const setCameraTarget = (next, instant = false) => {
    targetCam = clampCamera(next);
    if (instant) {
      cam = { ...targetCam };
      if (panorama) panorama.setAttribute('viewBox', `${cam.x.toFixed(1)} ${cam.y.toFixed(1)} ${cam.w.toFixed(1)} ${cam.h.toFixed(1)}`);
      return;
    }
    if (!rafId) rafId = window.requestAnimationFrame(renderCamera);
  };

  const zoomByFactor = (factor, clientX, clientY) => {
    if (!panorama) return;
    const rect = panorama.getBoundingClientRect();
    const relX = clientX !== undefined ? (clientX - rect.left) / rect.width : 0.5;
    const relY = clientY !== undefined ? (clientY - rect.top) / rect.height : 0.5;
    const focusX = targetCam.x + relX * targetCam.w;
    const focusY = targetCam.y + relY * targetCam.h;
    const newW = Math.max(300, Math.min(BASE_W, targetCam.w / factor));
    const newH = newW * (BASE_H / BASE_W);
    setCameraTarget({
      x: focusX - relX * newW,
      y: focusY - relY * newH,
      w: newW,
      h: newH
    });
  };

  let isDragging = false;
  let dragStart = { x: 0, y: 0, camX: 0, camY: 0 };

  if (skylineSection && panorama) {
    skylineSection.addEventListener('pointerdown', e => {
      if (e.target.closest('button, a, .v6-skyline__card, .skyline-mode-controls')) return;
      isDragging = true;
      skylineSection.classList.add('is-dragging');
      skylineSection.setPointerCapture(e.pointerId);
      dragStart = { x: e.clientX, y: e.clientY, camX: targetCam.x, camY: targetCam.y };
    });

    skylineSection.addEventListener('pointermove', e => {
      const rect = skylineSection.getBoundingClientRect();
      const nx = ((e.clientX - rect.left) / Math.max(1, rect.width)) - 0.5;  // -0.5 .. +0.5
      const ny = ((e.clientY - rect.top) / Math.max(1, rect.height)) - 0.5;  // -0.5 .. +0.5

      // Helicopter & searchlight playfully follow the user's mouse across the sky
      heliTarget = {
        x: nx * 135,
        y: ny * 52,
        rot: nx * 9.5,
        beamRot: -nx * 24 + ny * 10
      };
      if (!heliRafId) heliRafId = window.requestAnimationFrame(animateHeliPlay);

      if (!isDragging) return;
      if (targetCam.w >= BASE_W - 2) {
        const w = BASE_W / 1.25;
        const h = BASE_H / 1.25;
        targetCam.w = w;
        targetCam.h = h;
        dragStart.camX = (BASE_W - w) / 2;
        dragStart.camY = (BASE_H - h) / 2;
      }
      const scaleX = targetCam.w / rect.width;
      const scaleY = targetCam.h / rect.height;
      const dx = (e.clientX - dragStart.x) * scaleX;
      const dy = (e.clientY - dragStart.y) * scaleY;
      setCameraTarget({
        x: dragStart.camX - dx,
        y: dragStart.camY - dy,
        w: targetCam.w,
        h: targetCam.h
      }, true);
    });

