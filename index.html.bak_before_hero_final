        focusShortcutCard.innerHTML = `
          <div class="cab-ad-item__tag" style="color:#F28C28;">🎯 LSN В ФОКУСЕ • Главный промо-блок сайта</div>
          <div class="cab-ad-item__title" style="margin-bottom:8px;">${escapeHtml(heroFocusState.title || 'Грузовой пульс Сан-Андреаса')}</div>
          <div class="cab-ad-item__actions">
            <button type="button" class="cab-ad-mini-btn" data-uni-select="hero-focus">Редактировать блок</button>
          </div>
        `;
        listEl.appendChild(focusShortcutCard);

        const introCard = document.createElement('div');
        introCard.className = 'cab-ad-item cab-ad-item--intro' + (currentEditingId === 'staff-intro' ? ' is-editing' : '');
        introCard.innerHTML = `
          <div class="cab-ad-item__tag" style="color:#fbbf24;">Редакция LSN • Статья + 4 показателя</div>
          <div class="cab-ad-item__title" style="margin-bottom:8px;">${escapeHtml(staffState.articleTitle || 'Колонка редакции 102.2 FM')}</div>
          <div class="cab-ad-item__actions">
            <button type="button" class="cab-ad-mini-btn" data-uni-select="staff-intro">Редактировать</button>
          </div>
        `;
        listEl.appendChild(introCard);
      }

      // Staff: management may add anyone; every journalist-or-higher role may create one personal dossier.
      const myDossierBtn = $('#uni-my-dossier-btn');
      if (myDossierBtn) {
        const canPersonal = roleInfo.rank >= ROLE_HIERARCHY.journalist.rank;
        myDossierBtn.hidden = !canPersonal || !!myDossier;
      }
      if (newBtn) {
        if (roleInfo.level === 'admin') {
          newBtn.hidden = false;
          newBtn.textContent = '+ Сотрудник';
        } else if (roleInfo.rank >= ROLE_HIERARCHY.journalist.rank) {
          newBtn.hidden = false;
          if (myDossier) {
            newBtn.textContent = 'Открыть мою анкету';
          } else {
            newBtn.textContent = '+ Создать анкету';
          }
        } else {
          newBtn.hidden = true;
        }
      }
    } else {
      const myDossierBtn = $('#uni-my-dossier-btn');
      if (myDossierBtn) myDossierBtn.hidden = true;
    }

    const items = getStoreForType(currentUniType);
    const visibleItems = currentUniType === 'staff' && roleInfo.level === 'journalist'
      ? items.filter(item => isOwnStaffDossier(item, currentUser))
      : items;
    const ordered = currentUniType === 'news'
      ? [...visibleItems].sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0))
      : visibleItems;

    // Filter by search query and status filter
    const q = ($('#uni-items-search')?.value || '').trim().toLowerCase();
    const statusPill = $('#uni-status-filter-pills .cab-filter-pill.is-active')?.dataset.statusFilter || currentListStatusFilter || 'all';

    let filtered = ordered;
    if (q) {
      filtered = filtered.filter(item => {
        const t = (item.title || item.name || '').toLowerCase();
        const a = (item.author || '').toLowerCase();
        const s = (item.subtitle || item.role || item.category || '').toLowerCase();
        return t.includes(q) || a.includes(q) || s.includes(q);
      });
    }
    if (statusPill === 'draft') {
      filtered = filtered.filter(item => item.status === 'draft' || item.isDraft);
    } else if (statusPill === 'published') {
      filtered = filtered.filter(item => item.status !== 'draft' && item.status !== 'archived' && !item.isDraft);
    } else if (statusPill === 'archived') {
      filtered = filtered.filter(item => item.status === 'archived');
    }

    const counterEl = $('#uni-items-counter');
    if (counterEl) {
      counterEl.style.display = 'inline-block';
      counterEl.textContent = `${filtered.length} мат.`;
    }

    if (filtered.length === 0) {
      const emptyDiv = document.createElement('div');
      emptyDiv.style.cssText = 'padding:24px 16px; text-align:center; color:#94a3b8; font-size:13px; border:1px dashed rgba(255,255,255,0.08); border-radius:10px; margin-top:8px;';
      emptyDiv.innerHTML = q ? 'Материалы по вашему запросу не найдены.' : 'В этом разделе пока нет материалов.';
      listEl.appendChild(emptyDiv);
      return;
    }

    filtered.forEach((item, idx) => {
      const card = document.createElement('div');
      card.className = 'cab-ad-item' + (item.id === currentEditingId ? ' is-editing' : '');
      const titleText = escapeHtml((item.title || item.name || '').replace(/\n/g, ' '));
      let statusHtml = '';
      let bumpHtml = '';
      if (currentUniType === 'news') {
        const inMain = isInMainNews(item);
        const isDraft = item.status === 'draft' || item.isDraft;
        statusHtml = isDraft
          ? `<div class="cab-ad-item__tag" style="color:#fbbf24;">● ЧЕРНОВИК</div>`
          : inMain
          ? `<div class="cab-ad-item__tag" style="color:${item.important ? '#f43f5e' : '#fbbf24'};">${item.important ? '🔥 Важная (4 дн)' : '⚡ В эфире'} • ${formatMainLeft(item)}</div>`
          : `<div class="cab-ad-item__tag" style="color:#10b981;">● ОПУБЛИКОВАНО</div>`;
        if (!inMain && !isDraft) bumpHtml = `<button type="button" class="cab-ad-mini-btn" data-uni-bump="${item.id}">Поднять в эфир</button>`;
      } else if (currentUniType === 'staff') {
        statusHtml = `<div class="cab-ad-item__tag" style="color:#94a3b8;">Сотрудник #${idx + 1} • ${escapeHtml(item.role || '')}</div>`;
      } else if (currentUniType === 'column') {
