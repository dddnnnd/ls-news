      if (typeof updateMediaUI === 'function') updateMediaUI();
      if (typeof updateCabinetLivePreview === 'function') updateCabinetLivePreview();
      if (typeof updateArticleMetrics === 'function') updateArticleMetrics();
      renderUniItemsList();
