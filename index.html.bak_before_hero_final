        const fileInput = document.getElementById("uni-field-file");
        if (fileInput) fileInput.value = "";
        document.getElementById("lsn-media-library-dialog")?.close();
        if (typeof flashUniSaved === "function") {
          flashUniSaved(`📷 Выбрана локация: ${selectedMediaLibraryItem.district} (${selectedMediaLibraryItem.region})`);
        }
        return;
      }
    });

    document.addEventListener("input", (e) => {
      if (e.target.id === "lsn-media-search-input") {
        renderMediaLibraryGrid();
      }
    });
  };

  // =========================================================================
  // CUSTOM SLUG LOGIC & REAL-TIME URL PREVIEW
  // =========================================================================
  isSlugManuallyCustomized = false;

  const initCustomSlugEvents = () => {
    document.addEventListener("input", (e) => {
      if (e.target.id === "uni-field-title") {
        const slugInput = document.getElementById("uni-field-slug");
        const previewVal = document.getElementById("uni-slug-preview-val");
        if (!isSlugManuallyCustomized && slugInput) {
          const auto = (typeof generateSlugFromTitle === "function") ? generateSlugFromTitle(e.target.value) : "";
          slugInput.value = auto;
          if (previewVal) previewVal.textContent = auto || "novost";
        }
      } else if (e.target.id === "uni-field-slug") {
        const previewVal = document.getElementById("uni-slug-preview-val");
        const sanitized = e.target.value.toLowerCase().replace(/[^a-z0-9\-]/g, "");
        e.target.value = sanitized;
        isSlugManuallyCustomized = !!sanitized.length;
        if (previewVal) previewVal.textContent = sanitized || "novost";
      }
    });
  };

  // =========================================================================
  // PUBLIC ARTICLES SECTION: 16 THEMATIC TAG CHIPS FILTERING
  // =========================================================================
  currentArticleThematicFilter = "all";

  const initPublicArticleTags = () => {
    document.addEventListener("click", (e) => {
      const chip = e.target.closest("#lsn-article-tags-bar .lsn-tag-chip");
      if (chip) {
        document.querySelectorAll("#lsn-article-tags-bar .lsn-tag-chip").forEach(c => c.classList.remove("is-active"));
        chip.classList.add("is-active");
        currentArticleThematicFilter = chip.dataset.articleTag || "all";
        if (typeof renderEditorialColumns === "function") {
          renderEditorialColumns();
        }
      }
    });
  };

  // =========================================================================
  // ADMIN DIAGNOSTIC SPACE RENDERER
  // =========================================================================
  const renderAdminDiagnostics = () => {
    const newsEl = document.getElementById("admin-diag-news-count");
    const artEl = document.getElementById("admin-diag-articles-count");
    const staffEl = document.getElementById("admin-diag-staff-count");
    const syncEl = document.getElementById("admin-diag-sync-time");

    if (newsEl) newsEl.textContent = Array.isArray(newsState) ? newsState.length : 0;
    if (artEl) artEl.textContent = Array.isArray(columnsState) ? columnsState.length : 0;
    if (staffEl) staffEl.textContent = (typeof staffState !== "undefined" && staffState?.members) ? staffState.members.length : 0;
    if (syncEl) syncEl.textContent = new Date().toLocaleTimeString("ru-RU", { hour: "2-digit", minute: "2-digit", second: "2-digit" });
  };

  initMediaLibraryDialog();
  initCustomSlugEvents();
  initPublicArticleTags();
  if (typeof LSN_FAVORITES !== 'undefined') LSN_FAVORITES.syncUI();
  document.getElementById("admin-force-sync-btn")?.addEventListener("click", () => {
    renderAdminDiagnostics();
    if (typeof flashUniSaved === "function") flashUniSaved("✓ Данные аналитики обновлены");
  });

  syncSupabaseSessionAndProfiles();
  loadRadioRatingsFromCloud();
  } catch (err) { console.error('LSN bootstrap error:', err); }
});
</script>



