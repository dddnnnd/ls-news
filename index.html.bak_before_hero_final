}

.v6-skyline__cta-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 30px rgba(255, 140, 50, 0.58);
}
/* ----------------------------------------------------

   ADVERTISING CAROUSEL (V9 INTEGRATION)

   ---------------------------------------------------- */

#lsn-ad-carousel {

  margin: 0 clamp(20px, 6vw, 90px) 76px;

  position: relative;

  overflow: hidden;

  border: 1px solid var(--panel-border);

  border-radius: 22px;

  background: #0d1219;

}



.lsn-ad-slide {

  display: grid;

  grid-template-columns: 1.25fr 0.75fr;

  min-height: 270px;

  opacity: 0;

  transform: translateX(20px);

  pointer-events: none;

  position: absolute;

  inset: 0;

  transition: opacity 0.35s var(--ease), transform 0.35s var(--ease);

}



.lsn-ad-slide.is-active {

  position: relative;

  opacity: 1;

  transform: none;

  pointer-events: auto;

}



.lsn-ad-slide__copy {

  padding: 38px clamp(24px, 4vw, 54px);

  display: flex;

  flex-direction: column;

  justify-content: center;

}



.lsn-ad-slide__tag {

  font: 900 10px var(--font-mono);

  letter-spacing: 0.22em;

  color: var(--cyan);

  text-transform: uppercase;

}



.lsn-ad-slide__title {

  margin: 10px 0 10px;

  font-size: clamp(32px, 4.4vw, 56px);

  line-height: 0.95;

  letter-spacing: -0.055em;

  font-weight: 950;

  color: #fff;

}



.lsn-ad-slide__text {

  max-width: 620px;

  color: #929daa;

  font-size: 16px;

  line-height: 1.55;

  margin: 0;

}



.lsn-ad-slide__button {

  align-self: flex-start;

  margin-top: 22px;

  padding: 12px 20px;

  border-radius: 999px;

  background: var(--lime);

  color: #091006;

  text-decoration: none;

  font-weight: 900;

  font-size: 14px;

  border: 0;

  cursor: pointer;

  transition: transform 0.2s ease, box-shadow 0.2s ease;

}



.lsn-ad-slide__button:hover {

  transform: translateY(-2px);

  box-shadow: 0 8px 24px rgba(199, 255, 82, 0.35);

}



.lsn-ad-slide__art {

  position: relative;

  min-height: 270px;

  background: radial-gradient(circle at 35% 45%, rgba(245, 158, 11, 0.24), transparent 35%),

              linear-gradient(135deg, #111a23, #080b0f);

  overflow: hidden;

}



.lsn-ad-slide__art::after {

  content: "LSN / AD";

  position: absolute;

  right: 24px;

  top: 24px;

  color: rgba(255, 255, 255, 0.05);

  font: 950 clamp(54px, 8vw, 110px)/1 var(--font-mono);

  letter-spacing: -0.08em;

  transform: rotate(-6deg);

  pointer-events: none;

}



.lsn-ad-dots {

  position: absolute;

  right: 28px;

  bottom: 22px;

  display: flex;

  gap: 8px;

  z-index: 5;

}



.lsn-ad-dot {

  width: 9px;

  height: 9px;

  border: 0;

  border-radius: 50%;

  background: rgba(255, 255, 255, 0.25);

  cursor: pointer;

  padding: 0;

  transition: background 0.2s ease, transform 0.2s ease;

}



.lsn-ad-dot.is-active {

  background: var(--cyan);

  box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.24);

  transform: scale(1.15);

}



.lsn-ad-progress {

  position: absolute;

  left: 0;

  bottom: 0;

  height: 3px;

  width: 100%;

  background: linear-gradient(90deg, var(--cyan), var(--lime));

  transform-origin: left;

  transform: scaleX(0);

  z-index: 6;

}



.lsn-ad-progress.is-running {

  animation: lsnAdProgress 10s linear forwards;

}



@keyframes lsnAdProgress {

  to { transform: scaleX(1); }

}



/* ----------------------------------------------------

   COLUMNS & LATEST NEWS ROWS

   ---------------------------------------------------- */

.v6-secondary-news {

  display: grid;

  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));

  gap: 48px;

  padding: 0 clamp(20px, 6vw, 90px) 72px;

}



.latest-rows {

  display: flex;

  flex-direction: column;

}



/* Editorial quote cards */

.editorial-quote {

  padding: 28px;

  background: var(--panel);

  border-radius: 14px;

  border: 1px solid var(--panel-border);

  border-left: 4px solid var(--red);

  margin-bottom: 16px;

  transition: transform 0.2s ease;

}



.editorial-quote:hover {

  transform: translateY(-2px);

}



.editorial-quote.cyan {

  border-left-color: var(--cyan);

}



.editorial-quote__mark {

  font-family: var(--font-serif);

  font-size: 54px;

  line-height: 0.6;

  color: var(--red);

  font-weight: 900;

  margin-bottom: 8px;

}



.editorial-quote.cyan .editorial-quote__mark {

  color: var(--cyan);

}



.editorial-quote a {

  display: block;

  font-family: var(--font-serif);

  font-size: 22px;

  line-height: 1.3;

  font-weight: 700;

}



/* ----------------------------------------------------

   CALL TO ACTION & CONTACT

   ---------------------------------------------------- */

.v6-cta {

  margin: 0 clamp(20px, 6vw, 90px) 72px;

  padding: 54px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 32px;

  background: linear-gradient(125deg, #101620, #14222c);

  border: 1px solid var(--panel-border);

  border-radius: 22px;

  box-shadow: 0 24px 64px rgba(0, 0, 0, 0.35);

}



.v6-cta h3 {

  margin: 10px 0;

  font-size: clamp(28px, 4vw, 52px);

  line-height: 0.95;

  letter-spacing: -0.05em;

  color: #fff;

}



.v6-cta p {

  color: #929faa;

  max-width: 620px;

  margin: 0;

  font-size: 16px;

  line-height: 1.55;

}



/* ----------------------------------------------------

   FOOTER

   ---------------------------------------------------- */

footer {

  background: #05070a;

  border-top: 1px solid var(--panel-border);

  overflow: hidden;

}



.footer-marquee {

  font-family: var(--font-serif);

  font-weight: 900;

  font-size: clamp(48px, 12vw, 180px);

  line-height: 0.88;

  letter-spacing: -0.05em;

  padding: 36px clamp(20px, 6vw, 90px) 12px;

  white-space: nowrap;

  background: linear-gradient(90deg, #ecece9, var(--cyan) 50%, var(--lime));

  -webkit-background-clip: text;

  background-clip: text;

  color: transparent;

  opacity: 0.9;

}



.footer-bar {

  display: flex;

  flex-wrap: wrap;

  justify-content: space-between;

  align-items: center;

  gap: 20px;

  padding: 24px clamp(20px, 6vw, 90px) 36px;

  font-size: 14px;

  color: #8b96a4;

  border-top: 1px solid rgba(255, 255, 255, 0.05);

}



.footer-links {

  display: flex;

  gap: 22px;

  flex-wrap: wrap;

}



.footer-links a:hover {

  color: #fff;

}



/* ----------------------------------------------------

   MODAL DIALOGS

   ---------------------------------------------------- */

dialog {

  padding: 0;

  border: 0;

  background: transparent;

  color: #fff;

  max-width: none;

  max-height: none;

}



dialog::backdrop {

  background: rgba(0, 0, 0, 0.75);

  backdrop-filter: blur(8px);

  -webkit-backdrop-filter: blur(8px);

}



/* Article Dialog */

.article-dialog {

  width: min(840px, calc(100vw - 32px));

}



.article-dialog-card {

  position: relative;

  max-height: 90vh;

  overflow-y: auto;

  padding: clamp(24px, 5vw, 52px);

  border: 1px solid var(--panel-border);

  border-radius: 20px;

  background: rgba(14, 19, 26, 0.97);

  box-shadow: 0 40px 120px rgba(0, 0, 0, 0.75);

}



.article-toolbar {

  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-bottom: 24px;

}



.article-brand {

  font: 800 11px var(--font-mono);

  letter-spacing: 0.2em;

  color: var(--cyan);

  text-transform: uppercase;

}



.article-back {

  padding: 8px 16px;

  border-radius: 999px;

  border: 1px solid var(--panel-border);

  background: rgba(255, 255, 255, 0.06);

  color: #fff;

  font: 700 13px var(--font-sans);

  cursor: pointer;

  transition: 0.2s ease;

}



.article-back:hover {

  background: var(--cyan);

  color: #061015;

  border-color: var(--cyan);

}



.article-dialog-card h2 {

  font-family: var(--font-serif);

  font-size: clamp(30px, 5vw, 54px);

  line-height: 1.05;

  letter-spacing: -0.03em;

  margin: 12px 0 16px;

  color: #fff;

}



.article-meta {

  display: flex;

  gap: 16px;

  align-items: center;

  font-size: 13px;

  color: #8c97a5;

  margin-bottom: 24px;

}



.article-cover {

  width: 100%;

  max-height: 420px;

  object-fit: cover;

  border-radius: 14px;

  margin-bottom: 24px;

  border: 1px solid var(--panel-border);

}



.article-dialog-card p {

  color: #c7d2de;

  font-size: 17px;

  line-height: 1.7;

  margin: 0 0 18px;

}



/* Auth Dialog */

.auth-dialog {

  width: min(480px, calc(100vw - 32px));

}



.auth-modal-card {

  position: relative;

  padding: clamp(24px, 5vw, 42px);

  border: 1px solid var(--panel-border);

  border-radius: 20px;

  background: rgba(14, 19, 26, 0.98);

  box-shadow: 0 40px 120px rgba(0, 0, 0, 0.75);

}



.auth-dialog-close {

  position: absolute;

  top: 18px;

  right: 18px;

  width: 36px;

  height: 36px;

  border-radius: 50%;

  border: 1px solid var(--panel-border);

  background: rgba(255, 255, 255, 0.05);

  color: #fff;

  font-size: 20px;

  cursor: pointer;

  display: flex;

  align-items: center;

  justify-content: center;

  transition: 0.2s ease;

}



.auth-dialog-close:hover {

  border-color: var(--cyan);

  color: var(--cyan);

}



.portal-tabs {

  display: flex;

  gap: 8px;

  margin: 22px 0 20px;

  border-bottom: 1px solid var(--panel-border);

  padding-bottom: 10px;

}



.portal-tab {

  background: none;

  border: 0;

  color: #8a96a5;

  font: 700 14px var(--font-sans);

  padding: 8px 14px;

  border-radius: 8px;

  cursor: pointer;

}



.portal-tab.is-active {

  background: rgba(245, 158, 11, 0.16);

  color: var(--cyan);

}



.portal-form {

  display: grid;

  gap: 16px;

}



.portal-form[hidden] {

  display: none !important;

}



.portal-form label {

  display: grid;

  gap: 6px;

  font-size: 13px;

  color: #adb9c8;

}



.portal-form input {

  width: 100%;

  min-height: 46px;

  padding: 10px 14px;

  border: 1px solid var(--panel-border);

  border-radius: 8px;

  background: #080b0f;

  color: #fff;

  font: 15px var(--font-sans);

  transition: border-color 0.2s ease, outline 0.2s ease;

}



.portal-form input:focus {

  outline: 2px solid var(--cyan);

  border-color: transparent;

}



.portal-submit {

  min-height: 48px;

  border: 0;

  border-radius: 8px;

  background: linear-gradient(90deg, var(--cyan), var(--lime));

  color: #061015;

  font: 800 15px var(--font-sans);

  cursor: pointer;

  margin-top: 6px;

  transition: transform 0.2s ease;

}



.portal-submit:hover {

  transform: translateY(-1px);

}



.portal-link {

  background: none;

  border: 0;

  color: #8fa0b5;

  font-size: 13px;

  cursor: pointer;

  text-decoration: underline;

  text-align: left;

  padding: 0;

}



/* Ad Dialog */

#lsn-ad-dialog {

  width: min(680px, calc(100vw - 32px));

}



.lsn-ad-modal {

  padding: 34px;

  border: 1px solid var(--panel-border);

  border-radius: 20px;

  background: rgba(14, 19, 26, 0.98);

  box-shadow: 0 40px 120px rgba(0, 0, 0, 0.75);

}



.lsn-ad-modal__top {

  display: flex;

  justify-content: space-between;

  align-items: center;

  margin-bottom: 20px;

}



.lsn-ad-modal__close {

  border: 1px solid var(--panel-border);

  background: rgba(255, 255, 255, 0.05);

  color: #fff;

  border-radius: 999px;

  padding: 8px 14px;

  cursor: pointer;

}



.lsn-ad-modal h2 {

  margin: 0 0 14px;

  font-family: var(--font-serif);

  font-size: clamp(28px, 4.5vw, 48px);

  line-height: 1.05;

  color: #fff;

}



.lsn-ad-modal p {

  color: #a7b4c2;

  font-size: 16px;

  line-height: 1.6;

  margin: 0 0 24px;

}



.lsn-ad-modal__contact {

  display: inline-flex;

  padding: 12px 22px;

  border-radius: 999px;

  background: var(--lime);

  color: #091006;

  font-weight: 900;

  font-size: 14px;

}



/* ----------------------------------------------------

   RESPONSIVE QUERIES

   ---------------------------------------------------- */


/* Final polish: keyboard focus, reduced-motion, and safer touch targets. */
:focus-visible { outline: 2px solid var(--cyan); outline-offset: 3px; }
button, a, input, select, textarea { -webkit-tap-highlight-color: transparent; }
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; scroll-behavior: auto !important; }
}

@media (max-width: 900px) {

  .hero-v6 {

    grid-template-columns: 1fr;

    padding-top: 54px;

    gap: 36px;

  }

  .hero-v6__visual {

    min-height: 380px;

  }

  #news-grid article, #news-grid .tile {

    grid-column: span 12 !important;

  }

  .lsn-ad-slide {

    grid-template-columns: 1fr;

    min-height: 380px;

  }

  .lsn-ad-slide__art {

    min-height: 140px;

  }

  .v6-skyline {

    padding: 24px;

  }

  .v6-cta {

    display: block;

    padding: 36px 28px;

  }

  .v6-cta button {

    margin-top: 20px;

  }

}



@media (prefers-reduced-motion: reduce) {

  *, *::before, *::after {

    animation: none !important;

    transition: none !important;

