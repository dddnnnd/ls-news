/* ====================================================
   MODERN WEB GUIDANCE UPGRADES (CSS & UI BEHAVIORS)
   ==================================================== */

/* 1. Custom Scrollbar & Balanced Typography (customize-scrollbar-color-and-thickness, improve-text-layout-and-legibility) */
:root {
  scrollbar-width: thin;
  scrollbar-color: rgba(245, 158, 11, 0.38) #090b0f;
}

h1, h2, h3, .lsn-ad-slide__title, .hero-v6__title {
  text-wrap: balance;
}

p, .hero-v6__text, .lsn-ad-slide__text {
  text-wrap: pretty;
}

/* 2. State-Aware Sticky Header (state-aware-sticky-headers) */
header {
  transition: background 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
}
header.is-scrolled {
  background: rgba(7, 10, 15, 0.94);
  border-bottom-color: rgba(245, 158, 11, 0.32);
  box-shadow: 0 14px 40px rgba(0, 0, 0, 0.65), 0 1px 0 rgba(245, 158, 11, 0.18);
}

/* 3. Top-Layer Dialog Entry/Exit Animations (animate-to-from-top-layer & prevent-page-scroll-under-modal-dialog) */
html:has(dialog[open]) {
  overflow: hidden;
  scrollbar-gutter: stable;
}

dialog {
  opacity: 0;
  transform: translateY(16px) scale(0.97);
  transition:
    opacity 0.28s var(--ease),
    transform 0.28s var(--ease),
    overlay 0.28s var(--ease) allow-discrete,
    display 0.28s var(--ease) allow-discrete;
}

dialog[open] {
  opacity: 1;
  transform: translateY(0) scale(1);
}

@starting-style {
  dialog[open] {
    opacity: 0;
    transform: translateY(16px) scale(0.97);
  }
}

dialog::backdrop {
  opacity: 0;
  transition:
    opacity 0.28s ease,
    overlay 0.28s ease allow-discrete,
    display 0.28s ease allow-discrete;
}

dialog[open]::backdrop {
  opacity: 1;
}

@starting-style {
  dialog[open]::backdrop {
    opacity: 0;
  }
}

/* 4. Post-Interaction Form Validation (:user-invalid, :user-valid & style-parent-with-has) */
.portal-form input:user-invalid {
  border-color: var(--red);
  outline-color: var(--red);
  background: rgba(255, 82, 101, 0.06);
}

.portal-form input:user-valid {
  border-color: rgba(199, 255, 82, 0.55);
}

.portal-form label:has(input:user-invalid) {
  color: #ff8c9a;
}

.portal-form label:has(input:user-valid) {
  color: #d8f8a0;
}

/* 5. Interactive Skyline Broadcast Button & Mode Switcher */
/* Non-clickable broadcast status badge (102.2 FM) */
.lsn-audio-hint {
  padding: 2px 7px;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.08);
  color: #ffe599;
  font: 800 10px/1.2 var(--font-mono);
  letter-spacing: 0.08em;
}

.skyline-mode-controls {
  position: absolute;
  z-index: 6;
  right: 26px;
  bottom: 24px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px;
  border-radius: 999px;
  background: rgba(14, 9, 20, 0.84);
  border: 1px solid rgba(255, 183, 3, 0.38);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.5);
}

.skyline-mode-btn {
  border: 0;
  border-radius: 999px;
  padding: 6px 13px;
  background: transparent;
  color: #e2d4f0;
  font: 800 11.5px/1 var(--font-sans);
  letter-spacing: 0.04em;
