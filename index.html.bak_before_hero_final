      if (formTitle) formTitle.textContent = 'Редактирование статьи редакции';
      lblTitle.textContent = 'Заголовок колонки';
      lblSub.textContent = 'Рубрика / Подпись';
      lblBody.textContent = 'Текст статьи';
      $('#uni-item-id').value = 'staff-intro';
