  const LSN_FAVORITES = {
    getStorageKey() {
      const uid = (typeof currentUser !== "undefined" && currentUser)
        ? (currentUser.id || currentUser.uuid || currentUser.username || "guest")
        : "guest";
      return "lsn_favs_" + uid;
    },
    getAll() {
      try {
        const raw = localStorage.getItem(this.getStorageKey());
        return raw ? JSON.parse(raw) : [];
      } catch (_) {
        return [];
      }
    },
        save(list) {
      try {
        localStorage.setItem(this.getStorageKey(), JSON.stringify(list || []));
        this.syncUI();
        if (typeof currentUser !== "undefined" && currentUser && currentUser.id && typeof sb !== "undefined" && sb) {
          try {
            sb.from('profiles').update({
              metadata: { ...(currentUser.metadata || {}), favorites: list || [] }
            }).eq('id', currentUser.id).then(({ error }) => {
              if (error) console.warn("Supabase favorites sync:", error);
            });
          } catch (_) {}
        }
      } catch (e) {
        console.warn("LSN_FAVORITES save error:", e);
      }
    },
    async syncFromCloud() {
      if (typeof currentUser !== "undefined" && currentUser && currentUser.id && typeof sb !== "undefined" && sb) {
        try {
          const { data } = await sb.from('profiles').select('metadata').eq('id', currentUser.id).single();
          if (data && data.metadata && Array.isArray(data.metadata.favorites)) {
            const cloud = data.metadata.favorites;
            const current = this.getAll();
            const merged = [...current];
            cloud.forEach(c => {
              if (!merged.some(m => m.id === c.id)) merged.push(c);
            });
            localStorage.setItem(this.getStorageKey(), JSON.stringify(merged));
            this.syncUI();
          }
        } catch (_) {}
      }
    },
    has(id) {
      if (!id) return false;
      const all = this.getAll();
      return all.some(item => item.id === id || (item.slug && item.slug === id));
    },
    add(item) {
      if (!item || !item.id) return;
      const all = this.getAll();
      if (!all.some(x => x.id === item.id)) {
        all.unshift({
          id: item.id,
          slug: item.slug || item.id,
          type: item.type || "news",
          title: item.title || "Публикация LSN",
          category: item.category || item.tag || item.subtitle || "Редакция",
          dateText: item.dateText || item.date || "Недавно",
          img: item.img || item.customImg || "",
          addedAt: Date.now()
        });
        this.save(all);
        if (typeof flashUniSaved === "function") flashUniSaved("✓ Сохранено в закладки");
      }
    },
    remove(id) {
      if (!id) return;
      let all = this.getAll();
      all = all.filter(x => x.id !== id && x.slug !== id);
      this.save(all);
      if (typeof flashUniSaved === "function") flashUniSaved("Закладка удалена");
    },
    toggle(id, fallbackItem = null) {
      if (this.has(id)) {
        this.remove(id);
      } else {
        let item = fallbackItem;
        if (!item) {
          if (id === "hero-focus") {
            item = {
              id: "hero-focus",
              slug: "hero-focus",
              type: "focus",
              title: (typeof heroFocusState !== "undefined" && heroFocusState?.title) || "Грузоперевозки в Сан-Андреас",
              category: (typeof heroFocusState !== "undefined" && heroFocusState?.kicker) || "LSN В ФОКУСЕ",
              dateText: (typeof heroFocusState !== "undefined" && heroFocusState?.tag) || "Commerce",
              img: (typeof heroFocusState !== "undefined" && heroFocusState?.img) || "assets/lsn-trucker-editorial.jpg"
            };
          } else if (typeof newsState !== "undefined" && Array.isArray(newsState)) {
            const found = newsState.find(x => x.id === id || x.slug === id);
            if (found) item = { ...found, type: "news" };
          }
          if (!item && typeof columnsState !== "undefined" && Array.isArray(columnsState)) {
            const found = columnsState.find(x => x.id === id || x.slug === id);
            if (found) item = { ...found, type: "article" };
          }
        }
        if (item) this.add(item);
      }
    },
    syncUI() {
      const all = this.getAll();
      const counter = document.getElementById("account-favs-counter");
      if (counter) counter.textContent = all.length;

      const heroBtn = document.getElementById("hero-bookmark-btn");
      if (heroBtn) {
        const activeItem = (typeof getHeroRotationItems === 'function' && typeof currentHeroSlideIndex !== 'undefined') ? (getHeroRotationItems()[currentHeroSlideIndex] || { id: 'hero-focus' }) : { id: 'hero-focus' };
        const isFav = this.has(activeItem.id) || (activeItem.slug && this.has(activeItem.slug));
        heroBtn.classList.toggle("is-bookmarked", isFav);
        const span = heroBtn.querySelector("span");
        if (span) span.textContent = isFav ? "В закладках" : "В закладки";
      }

      const readerBtn = document.getElementById("reader-bookmark-btn");
      if (readerBtn && window.currentReadingPublicationId) {
        const isFav = this.has(window.currentReadingPublicationId);
        readerBtn.classList.toggle("is-bookmarked", isFav);
        const span = readerBtn.querySelector("span");
        if (span) span.textContent = isFav ? "В закладках" : "В закладки";
      }

      const favPanel = document.getElementById("account-tab-favorites");
      if (favPanel && !favPanel.hidden) {
        this.renderHub();
      }
    },
