    if (catEl) catEl.textContent = category || 'LOS SANTOS NEWS · 102.2 FM';
    if (titleEl) {
      titleEl.textContent = title || '';
      const safeReaderColor = safeHexColor(titleColor);
      if (safeReaderColor) {
        titleEl.style.color = safeReaderColor;
        titleEl.style.background = 'none';
        titleEl.style.webkitTextFillColor = safeReaderColor;
      } else {
        titleEl.style.color = '';
        titleEl.style.background = '';
        titleEl.style.webkitTextFillColor = '';
      }
    }
    const displayAuthorName = (author || 'Редакция LSN').trim();
    if (authorEl) {
      authorEl.innerHTML = `<span class="article-reader-author-prefix">Автор:</span> <strong class="article-reader-author-name" id="modal-article-author-name">${escapeHtml(displayAuthorName)}</strong>`;
    }
    if (dateEl) dateEl.textContent = dateText || 'Район Commerce · 102.2 FM';

    const paragraphs = (body || '').trim().split(/\n\s*\n/);
    if (excerptEl) {
      excerptEl.textContent = paragraphs[0] || '';
      excerptEl.style.color = safeHexColor(titleColor) || '#f1f5f9';
    }
    if (bodyEl) {
      if (paragraphs.length > 1) {
        bodyEl.innerHTML = renderSmartArticleContent(paragraphs.slice(1).join('\n\n'));
      } else {
        bodyEl.innerHTML = '';
      }
    }

    if (coverEl) {
      coverEl.classList.toggle('is-staff-portrait', type === 'staff' && id !== 'staff-intro');
      const safeCoverUrl = safeImageUrl(img);
      if (safeCoverUrl) {
        coverEl.src = safeCoverUrl;
        coverEl.hidden = false;
        if (coverBox) coverBox.hidden = false;
      } else {
        coverEl.removeAttribute('src');
        coverEl.hidden = true;
        if (coverBox) coverBox.hidden = true;
      }
    }

    // Author dossier matching & zero-broken-image avatar resolution
    const authorCard = $('#modal-article-author-card');
    const authorNameEl = $('#modal-author-card-name');
    const authorRoleEl = $('#modal-author-card-role');
    const authorBioEl = $('#modal-author-card-bio');
    const authorAvatarEl = $('#modal-author-card-avatar');
    const authorAvatarFallbackEl = $('#modal-author-card-avatar-fallback');
    const authorAvatarWrapEl = $('#modal-author-card-avatar-wrap');
    const authorHeaderAvatarEl = $('#modal-author-avatar');
    const authorHeaderFallbackEl = $('#modal-author-avatar-fallback');
    const authorHeaderWrapEl = $('#modal-author-avatar-wrap');
    const authorDeptEl = $('#modal-author-dept');

    const normAuthor = displayAuthorName.toLowerCase();
    const matchedAuthor = (staffState?.members || []).find(m => {
      if (!m) return false;
      const mName = String(m.name || '').trim().toLowerCase();
      const mLogin = String(m.authorLogin || '').trim().toLowerCase();
      return (mName && normAuthor && (mName === normAuthor || mName.includes(normAuthor) || normAuthor.includes(mName))) ||
             (mLogin && normAuthor && mLogin === normAuthor);
    });

    const computeAuthorInitials = (rawName) => {
      const cleaned = String(rawName || '').replace(/102\.2\s*FM/gi, '').replace(/[·•|—\-]/g, ' ').trim();
      if (!cleaned || /^редакция/i.test(cleaned) || /^los\s+santos\s+news/i.test(cleaned)) return 'LS';
      const parts = cleaned.split(/\s+/).filter(Boolean);
      if (parts.length >= 2) {
        return (parts[0].charAt(0) + parts[1].charAt(0)).toUpperCase();
      }
      return cleaned.slice(0, 2).toUpperCase();
    };

    const resolveAuthorPhotoUrl = (member) => {
      if (!member) return '';
      const direct = safeImageUrl(member.customImg || member.photo || member.img);
      if (direct && !direct.includes('lsn-immersive-v3/downtown.jpg')) return direct;
      if (member.skinId && Array.isArray(LSN_SKINS)) {
        const skin = LSN_SKINS.find(s => s.id === member.skinId);
        if (skin && skin.src) return skin.src;
      }
      return '';
    };

    const bindAvatarWithFallback = (imgNode, fallbackNode, wrapNode, url, initialsText) => {
      if (fallbackNode) {
        fallbackNode.textContent = initialsText;
        fallbackNode.hidden = false;
        fallbackNode.style.display = 'inline-flex';
      }
      if (!imgNode) return;
      imgNode.onload = null;
      imgNode.onerror = null;
      imgNode.hidden = true;
      imgNode.style.display = 'none';
      wrapNode?.classList.remove('has-photo');

      const cleanUrl = safeImageUrl(url);
      if (!cleanUrl || cleanUrl.includes('lsn-immersive-v3/downtown.jpg')) {
        imgNode.removeAttribute('src');
        return;
      }
      imgNode.onload = () => {
        if (imgNode.naturalWidth > 0) {
          imgNode.hidden = false;
          imgNode.style.display = 'block';
          if (fallbackNode) {
            fallbackNode.hidden = true;
            fallbackNode.style.display = 'none';
          }
          wrapNode?.classList.add('has-photo');
        }
      };
      imgNode.onerror = () => {
        imgNode.onload = null;
        imgNode.onerror = null;
        imgNode.removeAttribute('src');
        imgNode.hidden = true;
        imgNode.style.display = 'none';
        if (fallbackNode) {
          fallbackNode.hidden = false;
          fallbackNode.style.display = 'inline-flex';
        }
        wrapNode?.classList.remove('has-photo');
      };
      imgNode.src = cleanUrl;
    };

    const authorInitials = computeAuthorInitials(matchedAuthor?.name || displayAuthorName);
    const authorPhoto = resolveAuthorPhotoUrl(matchedAuthor);
    const authorRole = matchedAuthor?.role || (/^редакция/i.test(displayAuthorName) ? 'Редакционная коллегия · 102.2 FM' : 'Редактор · Los Santos News');
    const authorBio = matchedAuthor?.bio || 'Журналист и обозреватель Los Santos News. Оперативные репортажи и аналитика из всех районов штата Сан-Андреас.';

    if (authorNameEl) authorNameEl.textContent = displayAuthorName;
    if (authorRoleEl) authorRoleEl.textContent = authorRole;
    if (authorBioEl) authorBioEl.textContent = authorBio;
    if (authorDeptEl) authorDeptEl.textContent = authorRole;

    bindAvatarWithFallback(authorHeaderAvatarEl, authorHeaderFallbackEl, authorHeaderWrapEl, authorPhoto, authorInitials);
    bindAvatarWithFallback(authorAvatarEl, authorAvatarFallbackEl, authorAvatarWrapEl, authorPhoto, authorInitials);
    if (journalistBar) {
      journalistBar.hidden = !isUserAuthorizedJournalist(currentUser);
    }

    // Reading time calculation
    const wordCount = (body || '').trim().split(/\s+/).filter(Boolean).length;
    const readMinutes = Math.max(1, Math.ceil(wordCount / 180));
    const readTimeEl = $('#modal-article-read-time');
    if (readTimeEl) readTimeEl.textContent = `⏱ ~${readMinutes} мин. чтения`;

    // Breadcrumbs
    const crumbSec = $('#modal-crumb-section');
    const crumbCur = $('#modal-crumb-current');
    if (crumbSec) crumbSec.textContent = type === 'column' ? 'Статьи' : type === 'staff' ? 'Досье' : 'Новости';
    if (crumbCur) crumbCur.textContent = title ? (title.length > 40 ? title.slice(0, 40) + '…' : title) : 'Материал';

    // Actions bar buttons
    const copyBtn = $('#modal-copy-link-btn');
    if (copyBtn) {
      copyBtn.onclick = (e) => {
        e.preventDefault();
        copyPublicationLink(id, copyBtn);
      };
    }
    const shareBtn = $('#modal-share-btn');
    if (shareBtn) {
      shareBtn.onclick = (e) => {
        e.preventDefault();
        sharePublication({ id, title, excerpt: paragraphs[0] || '', body }, shareBtn);
      };
    }
    const copyFeedback = $('#modal-copy-feedback');
    if (copyFeedback) copyFeedback.textContent = '';

    // Scroll progress bar indicator and scroll reset
    if (!articleDialog._hasScrollProgress) {
      articleDialog._hasScrollProgress = true;
      articleDialog.addEventListener('scroll', () => {
        const progressEl = $('#article-reading-progress');
        if (!progressEl) return;
        const maxScroll = articleDialog.scrollHeight - articleDialog.clientHeight;
        const pct = maxScroll > 0 ? Math.min(100, Math.max(0, (articleDialog.scrollTop / maxScroll) * 100)) : 0;
        progressEl.style.width = `${pct}%`;
      }, { passive: true });
    }
    const progressEl = $('#article-reading-progress');
    if (progressEl) progressEl.style.width = '0%';
    articleDialog.scrollTop = 0;

    // Back to top & bottom close button listeners
    const backtopBtn = $('#modal-backtop-btn');
    if (backtopBtn) {
      backtopBtn.onclick = () => {
        articleDialog.scrollTo({ top: 0, behavior: 'smooth' });
      };
    }
    const bottomCloseBtn = $('#modal-article-bottom-close');
    if (bottomCloseBtn) {
      bottomCloseBtn.onclick = () => {
        articleDialog.close();
      };
    }

    // Related articles
    const relatedHost = $('#modal-article-related-grid');
    if (relatedHost) {
      relatedHost.innerHTML = '';
      const pool = [...(newsState || []), ...(columnsState || [])].filter(x => x && x.id && x.id !== id);
      const relatedItems = pool.slice(0, 3);
      relatedItems.forEach(rel => {
        const relCard = document.createElement('a');
        relCard.href = `?p=${encodeURIComponent(rel.id)}`;
        relCard.className = 'modal-related-card';
        const relImg = safeImageUrl(rel.img);
        relCard.innerHTML = `
          ${relImg ? `<img src="${escapeHtml(relImg)}" alt="" class="modal-related-thumb" loading="lazy">` : ''}
          <div class="modal-related-card-title">${escapeHtml(rel.title || '')}</div>
          <div class="modal-related-card-meta">${escapeHtml(rel.category || rel.subtitle || 'LSN')} · Читать →</div>
        `;
        relCard.addEventListener('click', (e) => {
          if (e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) return;
          e.preventDefault();
          openPublicationById(rel.id, { updateHistory: true });
        });
        relatedHost.appendChild(relCard);
      });
    }

    // Social metadata
    updateSocialMetadata({
      title: `${title} — Los Santos News`,
      description: paragraphs[0] || makeShortPreview(body, 160),
      image: safeImageUrl(img),
      url: getPublicationPermalink(id)
    });

    if (!articleDialog.open) articleDialog.showModal();
  };


  // =========================================================================
  // D. RENDER PAGE SECTIONS
  // =========================================================================
  const newsGridEl = $('#news-grid');
  const latestNewsEl = $('#latest-news');

  const formatNewsDate = (ts) => {
    try {
      const d = new Date(ts || Date.now());
      const datePart = new Intl.DateTimeFormat('ru-RU', {
        day: 'numeric',
        month: 'long'
      }).format(d);
      const timePart = new Intl.DateTimeFormat('ru-RU', {
        hour: '2-digit',
        minute: '2-digit'
      }).format(d);
      return `${datePart}, ${timePart}`;
    } catch (_) {
      return 'Сегодня';
    }
  };

  // Retention: обычная новость — 2 дня в «Главном», главная — 4 дня; потом — «Последние новости»
  const getMainRetentionMs = (art) => (art && art.important) ? FOUR_DAYS_MS : TWO_DAYS_MS;
  const isInMainNews = (art, now = Date.now()) => (now - (art.createdAt || now)) <= getMainRetentionMs(art);
  const formatMainLeft = (art) => {
    const leftMs = Math.max(0, getMainRetentionMs(art) - (Date.now() - (art.createdAt || Date.now())));
    const hours = Math.max(1, Math.ceil(leftMs / 3600000));
    return hours >= 24 ? `ещё ${Math.ceil(hours / 24)} дн.` : `ещё ${hours} ч.`;
  };

  const MAIN_ROTATE_MS = 15000;
  const mainPrevBtn = $('#main-news-prev');
  const mainNextBtn = $('#main-news-next');
  const mainCounterEl = $('#main-news-counter');
  const mainDotsEl = $('#main-news-dots');
  const mainProgressEl = $('#main-news-progress');
  let mainFreshList = [];
  let mainPage = 0;
  let mainTimer = null;
  let mainHover = false;

  const getMainPerPage = () => window.innerWidth >= 1100 ? 3 : (window.innerWidth >= 700 ? 2 : 1);
  const getMainPageCount = () => Math.max(1, Math.ceil(mainFreshList.length / getMainPerPage()));

  const openNewsInReader = (art) => {
    openUniversalReaderModal({
      type: 'news',
      id: art.id,
      category: art.category || 'НОВОСТИ · 102.2 FM',
      title: art.title,
      author: art.author || 'Редакция Los Santos News',
      dateText: formatNewsDate(art.createdAt),
      body: art.body,
      img: art.img
    });
  };

    const buildMainNewsTile = (art) => {
    const tile = document.createElement('a');
    tile.href = `?p=${encodeURIComponent(art.id)}`;
    tile.className = 'lsn-custom-news-card is-entering' + (art.important ? ' is-important' : '');
    tile.tabIndex = 0;
    const preview = escapeHtml(art.excerpt || makeShortPreview(art.body, 160));
    const imageUrl = safeImageUrl(art.img);
    tile.innerHTML = `
      <span class="news-fresh-pill${art.important ? ' news-fresh-pill--important' : ''}">${art.important ? 'ГЛАВНАЯ' : 'НОВОЕ'} · ${formatMainLeft(art)}</span>
      ${imageUrl ? `<div class="lsn-custom-news-card__thumb"><img src="${escapeHtml(imageUrl)}" alt="" loading="lazy" decoding="async"></div>` : ''}
      <div class="kick" style="margin-bottom:8px;">${escapeHtml(art.category || 'ГОРОД · 102.2 FM')}</div>
      <h3 class="ser lsn-news-title">${escapeHtml(art.title)}</h3>
      <p class="lsn-news-preview">${preview}</p>
      <div class="lsn-news-foot" style="display:flex;justify-content:space-between;align-items:center;font-size:12px;color:#94a3b8;border-top:1px solid rgba(255,255,255,0.06);padding-top:8px;margin-top:8px;">
        <span><b style="color:#e2e8f0;font-weight:600;">${escapeHtml(art.author || 'Редакция LSN')}</b> · ${formatNewsDate(art.createdAt)}</span>
        <span style="color:var(--cyan);font-weight:600;">Читать →</span>
      </div>
    `;
    tile.addEventListener('click', (e) => {
      if (e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      openPublicationById(art.id, { updateHistory: true });
    });
    tile.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openPublicationById(art.id, { updateHistory: true });
      }
    });
    return tile;
  };

  const restartMainProgress = () => {
    if (!mainProgressEl) return;
    mainProgressEl.classList.remove('is-running');
    if (reduceMotion || mainHover || document.hidden || getMainPageCount() < 2) return;
    void mainProgressEl.offsetWidth;
    mainProgressEl.classList.add('is-running');
  };

  const stopMainTimer = () => {
    window.clearInterval(mainTimer);
    mainTimer = null;
    if (mainProgressEl) mainProgressEl.classList.remove('is-running');
  };

  const showMainPage = (page) => {
    if (!newsGridEl) return;
    const per = getMainPerPage();
    const pages = getMainPageCount();
    mainPage = ((page % pages) + pages) % pages;
    newsGridEl.innerHTML = '';

    if (!mainFreshList.length) {
      newsGridEl.classList.remove('is-carousel');
      newsGridEl.innerHTML = `<p class="news-empty-state" data-empty-state role="status">Свежих новостей пока нет. Новости держатся в «Главном» 2 дня (главные — 4 дня), затем переходят в «Последние новости».</p>`;
    } else {
      newsGridEl.classList.add('is-carousel');
      newsGridEl.style.setProperty('--main-per-page', String(Math.max(1, Math.min(per, mainFreshList.length))));
      mainFreshList.slice(mainPage * per, mainPage * per + per).forEach(art => newsGridEl.appendChild(buildMainNewsTile(art)));
    }

    if (mainCounterEl) {
      mainCounterEl.textContent = `СТР. ${String(mainPage + 1).padStart(2, '0')} / ${String(pages).padStart(2, '0')}`;
    }
    if (mainPrevBtn) mainPrevBtn.disabled = pages < 2;
    if (mainNextBtn) mainNextBtn.disabled = pages < 2;
    if (mainDotsEl) {
      mainDotsEl.innerHTML = '';
      if (pages > 1) {
        for (let i = 0; i < pages; i++) {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'main-news-dot' + (i === mainPage ? ' is-active' : '');
          dot.dataset.mainPage = String(i);
          dot.setAttribute('aria-label', `Страница ${i + 1}`);
          mainDotsEl.appendChild(dot);
        }
      }
    }
    restartMainProgress();
  };

  const startMainTimer = () => {
    stopMainTimer();
    if (reduceMotion || document.hidden || mainHover || getMainPageCount() < 2) return;
    mainTimer = window.setInterval(() => showMainPage(mainPage + 1), MAIN_ROTATE_MS);
    restartMainProgress();
  };

  mainPrevBtn?.addEventListener('click', () => { showMainPage(mainPage - 1); startMainTimer(); });
  mainNextBtn?.addEventListener('click', () => { showMainPage(mainPage + 1); startMainTimer(); });
  mainDotsEl?.addEventListener('click', (e) => {
    const dot = e.target.closest('[data-main-page]');
    if (!dot) return;
    showMainPage(Number(dot.dataset.mainPage) || 0);
    startMainTimer();
  });
  if (newsGridEl) {
    newsGridEl.addEventListener('mouseenter', () => { mainHover = true; stopMainTimer(); });
    newsGridEl.addEventListener('mouseleave', () => { mainHover = false; startMainTimer(); });
  }
  document.addEventListener('visibilitychange', () => document.hidden ? stopMainTimer() : startMainTimer());
  let lastMainPerPage = getMainPerPage();
  window.addEventListener('resize', () => {
    const p = getMainPerPage();
    if (p !== lastMainPerPage) {
      lastMainPerPage = p;
      showMainPage(0);
      startMainTimer();
    }
  }, { passive: true });

  // «Последние новости» = все новости с интерактивным дизайном и фильтрами
  const LATEST_STEP = 6;
  let latestVisible = LATEST_STEP;
  let currentLatestFilter = 'all';

  const renderLatestArchive = (archive) => {
    latestNewsEl.innerHTML = '';
    const totalBadge = $('#latest-news-total-badge');
    if (totalBadge) {
      const count = archive.length;
      totalBadge.textContent = `${count} ${count === 1 ? 'публикация' : count >= 2 && count <= 4 ? 'публикации' : 'публикаций'}`;
    }
    const cntAll = $('#filter-cnt-all');
    if (cntAll) cntAll.textContent = String(archive.length);

    const filterTerms = {
      город: ['город', 'commerce', 'улиц', 'транспорт'],
      политика: ['полит', 'мэр', 'правитель', 'закон'],
      экономика: ['эконом', 'финанс', 'бизнес', 'рынок'],
      культура: ['культур', 'шоу', 'вайнвуд', 'вечер'],
      чп: ['чп', 'происшеств', 'хроник', 'срочн', 'полици']
    };
    const terms = filterTerms[currentLatestFilter] || [currentLatestFilter];
    const filtered = currentLatestFilter === 'all'
      ? archive
      : archive.filter(a => {
          const category = (a.category || '').toLowerCase();
          return terms.some(term => category.includes(term));
        });

    if (!filtered.length) {
      const message = currentLatestFilter === 'all'
        ? 'Новых публикаций пока нет.'
        : 'В этой рубрике пока нет публикаций.';
      latestNewsEl.innerHTML = `<p class="news-empty-state news-empty-state--compact">${message}</p>`;
      return;
    }

        filtered.slice(0, latestVisible).forEach((art) => {
      const row = document.createElement('a');
      row.href = `?p=${encodeURIComponent(art.id)}`;
      row.className = 'latest-row-item';
      row.tabIndex = 0;
      row.setAttribute('role', 'link');
      row.setAttribute('aria-label', `Открыть публикацию: ${art.title || ''}`);

      const catRaw = (art.category || 'Новости').trim();
      const catClean = catRaw.split('·')[0].split('•')[0].trim();
      const catLower = catClean.toLowerCase();
      let catClass = 'latest-cat-pill--default';
      if (catLower.includes('город') || catLower.includes('commerce')) catClass = 'latest-cat-pill--город';
      else if (catLower.includes('культур') || catLower.includes('вайнвуд')) catClass = 'latest-cat-pill--культура';
      else if (catLower.includes('полит') || catLower.includes('мэр')) catClass = 'latest-cat-pill--политика';
      else if (catLower.includes('эконом') || catLower.includes('финанс')) catClass = 'latest-cat-pill--экономика';
      else if (catLower.includes('чп') || catLower.includes('происшеств') || catLower.includes('хроник')) catClass = 'latest-cat-pill--чп';

      const safeNewsImg = safeImageUrl(art.img);
      const mediaHtml = safeNewsImg
        ? `<div class="latest-row-media"><img src="${escapeHtml(safeNewsImg)}" alt="" loading="lazy" decoding="async"></div>`
        : `<div class="latest-row-media latest-row-media--brand-tile" aria-hidden="true"><span class="latest-media-mark">LSN</span><span class="latest-media-rule"></span><span class="latest-media-caption">Редакция · San Andreas</span></div>`;
      const excerpt = escapeHtml(art.excerpt || makeShortPreview(art.body, 150));
      const date = formatNewsDate(art.createdAt);

      row.innerHTML = `
        ${mediaHtml}
        <div class="latest-row-content">
          <div class="latest-row-meta">
            <span class="latest-cat-pill ${catClass}">${escapeHtml(catClean)}</span>
            <span class="meta-separator" aria-hidden="true">·</span>
            <span class="latest-meta-author">${escapeHtml(art.author || 'Редакция Los Santos News')}</span>
            <span class="meta-separator" aria-hidden="true">·</span>
            <time class="latest-meta-time">${escapeHtml(date)}</time>
          </div>
          <h4 class="latest-row-title">${escapeHtml(art.title)}</h4>
          <p class="latest-row-excerpt">${excerpt}</p>
          <div class="latest-row-footer">
            <span class="latest-read-link">Открыть материал <span class="latest-arr" aria-hidden="true">→</span></span>
          </div>
        </div>
      `;

      row.addEventListener('click', (e) => {
        if (e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        openPublicationById(art.id, { updateHistory: true });
      });
      row.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openPublicationById(art.id, { updateHistory: true });
        }
      });
      latestNewsEl.appendChild(row);
    });

    if (filtered.length > latestVisible) {
      const remaining = filtered.length - latestVisible;
      const more = document.createElement('button');
      more.type = 'button';
      more.className = 'latest-more-btn';
      more.textContent = `Показать ещё (${remaining})`;
      more.addEventListener('click', () => {
        latestVisible += LATEST_STEP;
        renderLatestArchive(archive);
      });
      latestNewsEl.appendChild(more);
    }
  };

  // Interactive Category Filter Bar clicks
  $('#latest-news-filters')?.addEventListener('click', (e) => {
    const chip = e.target.closest('.latest-filter-chip');
    if (!chip || chip.id === 'mobile-force-refresh-btn') return;
    $$('.latest-filter-chip[data-cat]', $('#latest-news-filters')).forEach(c => c.classList.remove('is-active'));
    chip.classList.add('is-active');
    currentLatestFilter = chip.dataset.cat || 'all';
    latestVisible = LATEST_STEP;
    const published = newsState.filter(a => (a.status || 'published') === 'published');
    const sorted = [...published].sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
    renderLatestArchive(sorted);
  });

  const renderNewsSections = () => {
    if (!newsGridEl || !latestNewsEl) return;
    const now = Date.now();
    // Drafts remain available in the editorial cabinet, never in the public feed.
    const published = newsState.filter(a => (a.status || 'published') === 'published');
    const sorted = [...published].sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
    mainFreshList = sorted
      .filter(a => isInMainNews(a, now))
      .sort((a, b) => ((b.important ? 1 : 0) - (a.important ? 1 : 0)) || ((b.createdAt || 0) - (a.createdAt || 0)));
    showMainPage(mainPage);
    startMainTimer();
