/* News Grid Container */

#news-grid, .news-grid {

  padding: 0 clamp(20px, 6vw, 90px) 72px;

  display: grid !important;

  grid-template-columns: repeat(12, minmax(0, 1fr)) !important;

  gap: 18px !important;

}



#news-grid article, #news-grid .tile, .news-card {

  position: relative;

  min-height: 320px;

  overflow: hidden;

  display: flex;

  flex-direction: column;

  justify-content: flex-end;

  padding: 26px;

  background: var(--panel) !important;

  border: 1px solid var(--panel-border) !important;

  border-radius: 18px !important;

  text-decoration: none;

  color: #fff;

  transition: transform 0.35s var(--ease), border-color 0.25s ease, box-shadow 0.35s ease !important;

}



#news-grid article:nth-child(4n+1), #news-grid .tile:nth-child(4n+1) { grid-column: span 6; }

#news-grid article:nth-child(4n+2), #news-grid .tile:nth-child(4n+2) { grid-column: span 3; }

#news-grid article:nth-child(4n+3), #news-grid .tile:nth-child(4n+3) { grid-column: span 3; }

#news-grid article:nth-child(4n),   #news-grid .tile:nth-child(4n)   { grid-column: span 4; }



#news-grid article:hover, #news-grid .tile:hover, .news-card:hover {

  transform: translateY(-5px);

  border-color: rgba(245, 158, 11, 0.45) !important;

  box-shadow: 0 24px 64px rgba(0, 0, 0, 0.45), 0 0 30px rgba(245, 158, 11, 0.16) !important;

}



/* ----------------------------------------------------
   GTA SAN ANDREAS PANORAMIC SKYLINE & FREEWAY TRAFFIC
   ---------------------------------------------------- */
.v6-skyline {
  position: relative;
  min-height: clamp(600px, 50vw, 760px);
  margin: 0 clamp(20px, 6vw, 90px) 74px;
  border-radius: 24px;
  overflow: hidden;
  border: 1px solid rgba(255, 166, 68, 0.45);
  box-shadow: 0 28px 90px rgba(0, 0, 0, 0.85), 0 0 60px rgba(255, 110, 64, 0.16);
  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
  padding: 34px;
  background: #120914;
  user-select: none;
  cursor: grab;
}

.v6-skyline.is-dragging {
  cursor: grabbing;
}

.gta-sky-svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}

/* SAN NEWS (D193SA) Helicopter flight path across the sunset twilight sky */
.gta-chopper-rig {
  animation: gtaFlight 24s ease-in-out infinite alternate;
}

@keyframes gtaFlight {
  0% {
    transform: translate(-135px, 10px) rotate(-2deg);
  }
  35% {
    transform: translate(35px, -12px) rotate(2.2deg);
  }
  70% {
    transform: translate(165px, 5px) rotate(2.8deg);
  }
  100% {
    transform: translate(255px, -8px) rotate(-1.8deg);
  }
}

/* High-speed rotor spin */
.gta-rotor {
  transform-box: fill-box;
  transform-origin: center;
  animation: gtaSpin 0.06s linear infinite;
}

@keyframes gtaSpin {
  0% { transform: scaleX(1); opacity: 0.95; }
  50% { transform: scaleX(0.12); opacity: 0.38; }
  100% { transform: scaleX(1); opacity: 0.95; }
}

/* Aviation & Rooftop Strobe Lights */
.gta-strobe-red {
  animation: gtaStrobe 1.1s steps(1) infinite;
}
.gta-strobe-cyan {
  animation: gtaStrobe 0.85s steps(1) 0.25s infinite;
}
.gta-strobe-white {
  animation: gtaStrobe 0.75s steps(1) 0.5s infinite;
}

@keyframes gtaStrobe {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.12; }
}

/* Helicopter searchlight beam sweeping down toward the freeway interchange */
.gta-searchlight-beam {
  transform-origin: 472px 146px;
  animation: gtaSweep 6.2s ease-in-out infinite alternate;
}

@keyframes gtaSweep {
  0% { transform: rotate(-18deg); opacity: 0.55; }
  50% { transform: rotate(5deg); opacity: 0.88; }
  100% { transform: rotate(20deg); opacity: 0.62; }
}

/* Vinewood festival sky beams sweeping behind the hills */
.gta-sky-beam-1 {
  transform-origin: 185px 195px;
  animation: gtaSkyBeam1 9s ease-in-out infinite alternate;
}
.gta-sky-beam-2 {
  transform-origin: 310px 235px;
  animation: gtaSkyBeam2 11s ease-in-out infinite alternate;
}
@keyframes gtaSkyBeam1 {
  0% { transform: rotate(-20deg); opacity: 0.18; }
  100% { transform: rotate(15deg); opacity: 0.38; }
}
@keyframes gtaSkyBeam2 {
  0% { transform: rotate(16deg); opacity: 0.15; }
  100% { transform: rotate(-18deg); opacity: 0.34; }
}

/* Flowing Freeway Traffic Light Streams */
.gta-stream-out-fast {
  stroke-dasharray: 22 34 16 40 28 46;
  animation: gtaStreamFlowOut 2.8s linear infinite;
}
.gta-stream-out-med {
  stroke-dasharray: 16 42 24 36 14 50;
  animation: gtaStreamFlowOut 3.8s linear infinite;
}
.gta-stream-in-fast {
  stroke-dasharray: 20 34 26 40 16 44;
  animation: gtaStreamFlowIn 2.6s linear infinite;
}
.gta-stream-in-med {
  stroke-dasharray: 14 40 20 46 22 38;
  animation: gtaStreamFlowIn 3.6s linear infinite;
}
.gta-stream-bridge {
  stroke-dasharray: 24 48 16 56;
  animation: gtaStreamFlowOut 3.2s linear infinite;
}

@keyframes gtaStreamFlowOut {
  from { stroke-dashoffset: 220; }
  to   { stroke-dashoffset: 0; }
}
@keyframes gtaStreamFlowIn {
  from { stroke-dashoffset: 0; }
  to   { stroke-dashoffset: -220; }
}

/* Police Siren Alternating Red/Blue Strobe */
.gta-cop-strobe-red {
  animation: gtaCopRed 0.25s steps(1) infinite;
}
.gta-cop-strobe-blue {
  animation: gtaCopBlue 0.25s steps(1) infinite;
}
@keyframes gtaCopRed {
  0%, 49% { opacity: 1; }
  50%, 100% { opacity: 0.08; }
}
@keyframes gtaCopBlue {
  0%, 49% { opacity: 0.08; }
  50%, 100% { opacity: 1; }
}

/* Rooftop LSN Billboard & Building Window Glow */
.gta-lsn-billboard-glow {
  animation: gtaBillboardPulse 4s ease-in-out infinite alternate;
}
@keyframes gtaBillboardPulse {
  0% { opacity: 0.88; filter: drop-shadow(0 0 8px rgba(255, 160, 80, 0.45)); }
  100% { opacity: 1; filter: drop-shadow(0 0 16px rgba(255, 110, 60, 0.8)); }
}

.gta-window-twinkle-1 {
  animation: gtaTwinkle 3.8s ease-in-out infinite alternate;
}
.gta-window-twinkle-2 {
  animation: gtaTwinkle 5.2s ease-in-out 1.4s infinite alternate;
}
@keyframes gtaTwinkle {
  0%, 25% { opacity: 0.25; }
  75%, 100% { opacity: 0.95; }
}

/* Equalizer bars inside LSN · ЭФИР 24/7 badge */
.lsn-eq-bars {
  display: inline-flex;
  align-items: flex-end;
  gap: 2.5px;
  height: 12px;
  margin-left: 2px;
}
.lsn-eq-bars i {
  display: inline-block;
  width: 2.5px;
  border-radius: 2px;
  background: linear-gradient(180deg, #ffd166, #ff4d6d);
  animation: lsnEqBounce 0.7s ease-in-out infinite alternate;
}
.lsn-eq-bars i:nth-child(1) { height: 6px; animation-delay: 0s; }
.lsn-eq-bars i:nth-child(2) { height: 12px; animation-delay: 0.2s; }
.lsn-eq-bars i:nth-child(3) { height: 8px; animation-delay: 0.4s; }
@keyframes lsnEqBounce {
  0% { transform: scaleY(0.45); opacity: 0.75; }
  100% { transform: scaleY(1); opacity: 1; }
}

/* Free-Look City Explorer HUD Bar (Top Center, appears in "👁 Вид" or when zooming/panning) */
.skyline-explorer-hud {
  position: absolute;
  z-index: 7;
  top: 24px;
  left: 50%;
  transform: translateX(-50%);
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 12px;
  border-radius: 999px;
  background: rgba(14, 10, 22, 0.88);
  border: 1px solid rgba(245, 158, 11, 0.45);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  color: #e2e8f0;
  font: 700 12px/1 var(--font-sans);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.65), 0 0 20px rgba(245, 158, 11, 0.22);
  transition: opacity 0.25s ease, transform 0.25s ease;
}
.skyline-explorer-hud[hidden] {
  display: none !important;
}
.skyline-hud-btn {
  border: 1px solid rgba(255, 255, 255, 0.18);
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  border-radius: 999px;
  padding: 4px 10px;
  font: 800 11px/1 var(--font-sans);
  cursor: pointer;
  transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
}
.skyline-hud-btn:hover {
  background: var(--cyan);
  border-color: var(--cyan);
  color: #061015;
}
.skyline-zoom-readout {
  font: 800 11px/1 var(--font-mono);
  color: #ffd166;
  min-width: 36px;
  text-align: center;
}

/* Skyline Overlay Card (Positioned Bottom-Left over dark hillside so Freeway & LSN Tower stay 100% clear) */
.v6-skyline__card {
  position: relative;
  z-index: 5;
