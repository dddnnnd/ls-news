    const listEl = $('#uni-items-list');
    if (!listEl) return;
    listEl.innerHTML = '';

    const newBtn = $('#uni-new-item-btn');
    if (newBtn) newBtn.hidden = !canCreateCurrent;

    if (currentUniType === 'focus') {
