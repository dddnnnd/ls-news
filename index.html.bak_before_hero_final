  const ARCHIVE_STORAGE_KEY = 'lsn_archive_store_v12';
  let archiveFilter = 'all';

  const getLocalArchive = () => {
    try {
      const raw = localStorage.getItem(ARCHIVE_STORAGE_KEY);
      return raw ? JSON.parse(raw) : [];
    } catch (_) { return []; }
  };

  const saveLocalArchive = (items) => {
    try {
      localStorage.setItem(ARCHIVE_STORAGE_KEY, JSON.stringify(items));
    } catch (_) {}
  };

  const saveItemToLocalArchive = (item) => {
    if (!item || !item.id) return;
    const current = getLocalArchive();
    const idx = current.findIndex(x => x.id === item.id);
    if (idx >= 0) current[idx] = item;
    else current.unshift(item);
    saveLocalArchive(current);
  };

  const removeFromLocalArchive = (id) => {
