  });

  $('#login-panel')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const identifier = ($('#login-identifier').value || '').trim();
    const password = $('#login-password').value || '';
    const msg = $('#auth-message');
    const btn = e.target.querySelector('button[type="submit"]');
    if (!identifier || !password) {
      if (msg) msg.textContent = '⚠️ Введите никнейм/email и пароль.';
      return;
    }
    if (!sb) {
      if (msg) msg.textContent = '⚠️ Supabase не подключён. Проверьте интернет и настройки проекта.';
      return;
    }
    if (btn) { btn.disabled = true; btn.textContent = 'Вход…'; }
    try {
      let data = null;
      const cleanNick = identifier.replace(/\s+/g, ' ').trim();

      if (identifier.includes('@')) {
        const result = await sb.auth.signInWithPassword({ email: identifier.toLowerCase(), password });
        if (result.error) throw result.error;
        data = result.data;
      } else {
        let signedIn = false;

        // 1. Попытка Edge-функции username-login
        try {
          const { data: loginResult, error: loginError } = await sb.functions.invoke('username-login', {
            body: { username: cleanNick, password }
          });
          if (!loginError && loginResult?.session?.access_token && loginResult?.session?.refresh_token) {
            const { data: sessionData, error: sessionError } = await sb.auth.setSession({
              access_token: loginResult.session.access_token,
              refresh_token: loginResult.session.refresh_token
            });
            if (!sessionError && sessionData?.user) {
              data = sessionData;
              signedIn = true;
            }
          }
        } catch (edgeErr) {
          console.warn('Edge username-login attempt:', edgeErr);
        }

        // 2. Авторизация по никнейму выполняется строго через защищённую Edge Function username-login
        if (!data?.user) {
          throw new Error('Неверный никнейм или пароль. (Вы также можете войти, указав email).');
        }
      }

      if (!data?.user) throw new Error('Supabase не вернул пользователя.');

      let profile = null;
      try {
        const { data: pData, error: pErr } = await sb
          .from('profiles')
          .select('id,user_id_code,username,email,role,role_title')
          .eq('id', data.user.id)
          .maybeSingle();
        if (!pErr && pData) profile = pData;
      } catch (profError) {
        console.warn('Profile read after login note:', profError);
      }

      const email = profile?.email || data.user.email || (identifier.includes('@') ? identifier.toLowerCase() : '');
      const serverRole = (profile && profile.role) ? String(profile.role).toLowerCase() : 'user';
      const serverRoleTitle = (profile && profile.role_title) ? String(profile.role_title) : (ROLE_HIERARCHY[serverRole]?.title || 'Читатель');

      currentUser = {
        id: profile?.user_id_code || data.user.id.slice(0, 8),
        uuid: data.user.id,
        username: profile?.username || data.user.user_metadata?.username || cleanNick,
        fullName: profile?.username || data.user.user_metadata?.full_name || cleanNick,
        email: email,
        role: serverRole,
        roleTitle: serverRoleTitle
      };

      try { localStorage.setItem(SESSION_USER_KEY, JSON.stringify(currentUser)); } catch (_) {}
      if (msg) msg.textContent = '✅ Вход выполнен.';
      syncRoleVisibilityUI();
      try {
        if (authDialog && typeof authDialog.close === 'function') authDialog.close();
        else authDialog?.removeAttribute('open');
      } catch (_) {
        authDialog?.removeAttribute('open');
      }
      if (isUserAuthorizedJournalist(currentUser)) openJournalistCabinet('news');
    } catch (err) {
      console.error('Login error:', err);
      if (msg) msg.textContent = '⚠️ ' + (err?.message || 'Не удалось выполнить вход.');
    } finally {
      if (btn) { btn.disabled = false; btn.textContent = 'Войти'; }
    }
  });

  $('#apply-panel')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const username = ($('#reg-username').value || '').replace(/\s+/g, ' ').trim();
    const email = ($('#reg-email').value || '').trim().toLowerCase();
    const password = $('#reg-password').value || '';
    const msg = $('#auth-message');
    const btn = e.target.querySelector('button[type="submit"]');

    // Только формат Имя Фамилия: две части, буквы RU/EN, один пробел между ними.
    if (!/^[A-Za-zА-Яа-яЁё]+ [A-Za-zА-Яа-яЁё]+$/.test(username) || username.length < 5 || username.length > 60) {
      if (msg) msg.textContent = '⚠️ Никнейм должен быть строго в формате «Имя Фамилия». Без цифр, подчёркиваний и третьего слова.';
      return;
    }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      if (msg) msg.textContent = '⚠️ Укажите корректный email.';
      return;
    }
    if (password.length < 8) {
      if (msg) msg.textContent = '⚠️ Пароль должен содержать минимум 8 символов.';
      return;
    }
    if (!sb) {
      if (msg) msg.textContent = '⚠️ Supabase не подключён.';
      return;
    }
    if (btn) { btn.disabled = true; btn.textContent = 'Регистрация…'; }
    try {
      // Безопасность: нельзя создавать новый аккаунт поверх активной сессии
      // (например, когда сейчас открыт предыдущий аккаунт). Иначе Supabase
      // может сохранить текущую сессию и интерфейс продолжит показывать admin.
      const { data: activeSession } = await sb.auth.getSession();
      if (activeSession?.session?.user) {
        throw new Error('Сначала выйдите из текущего аккаунта, затем зарегистрируйте новый.');
      }

      const { data: availabilityResult, error: nickError } = await sb.functions.invoke('username-available', {
        body: { username }
      });
      if (nickError || availabilityResult?.available !== true) {
        throw new Error('Этот никнейм уже зарегистрирован или недоступен.');
      }

      const { data: signData, error: signError } = await sb.auth.signUp({
        email,
        password,
        options: { data: { username } }
      });
      if (signError) throw signError;
      if (!signData?.user) throw new Error('Supabase не вернул созданного пользователя.');

      // Email confirmation у проекта отключён, поэтому новая сессия должна
      // появиться сразу. Если её нет — не создаём локального пользователя.
      if (!signData.session) {
        if (msg) msg.textContent = '⚠️ Аккаунт создан, но сессия не выдана. Проверьте настройки подтверждения email в Supabase.';
        return;
      }

      // Триггер Supabase создаёт профиль с ролью user. Ждём его появления,
      // чтобы не продолжать работу с неполным/старым профилем.
      let profile = null;
      let profileError = null;
      for (let attempt = 0; attempt < 5; attempt++) {
        const result = await sb
          .from('profiles')
          .select('id,user_id_code,username,email,role,role_title')
          .eq('id', signData.user.id)
          .maybeSingle();
        profile = result.data;
        profileError = result.error;
        if (profile) break;
        await new Promise(resolve => setTimeout(resolve, 250));
      }
      if (profileError) throw profileError;
      if (!profile) throw new Error('Профиль пользователя не создан. Регистрация остановлена для безопасности.');

      // Никогда не выдаём права из клиентского fallback. Роль должна прийти
      // из profiles и для новой регистрации обязана быть user.
      if (profile.id !== signData.user.id || profile.role !== 'user') {
        await sb.auth.signOut();
        currentUser = null;
        throw new Error('Ошибка безопасности: новый аккаунт получил некорректную роль. Администратор не назначается автоматически.');
      }

      currentUser = {
        id: profile.user_id_code || signData.user.id,
        uuid: signData.user.id,
        username: profile.username || username,
        fullName: profile.username || username,
        email: profile.email || email,
        role: 'user',
        roleTitle: profile.role_title || '👤 Пользователь'
      };
      syncRoleVisibilityUI();
      authDialog?.close();
      flashUniSaved('Регистрация успешна!');
    } catch (err) {
      console.error('Registration error:', err);
      const text = String(err?.message || 'Не удалось зарегистрировать аккаунт.');
      if (msg) msg.textContent = text.toLowerCase().includes('already registered') || text.toLowerCase().includes('already been registered')
        ? '⚠️ Пользователь с таким email уже зарегистрирован.'
        : '⚠️ ' + text;
    } finally {
      if (btn) { btn.disabled = false; btn.textContent = 'Зарегистрироваться'; }
    }
  });

  // F. SIMPLIFIED UNIFIED EDITOR CONTROLLER INSIDE #cabinet-dialog
  // =========================================================================
  let currentUniType = 'news';
  let currentEditingId = null;
  let currentPhotoData = '';
  let currentArtPreset = '';
  let uniSaveTimer = null;
  let myActCurrentFilter = 'all';

  const flashUniSaved = (text = 'Сохранено') => {
    const uniSavePill = $('#uni-save-pill');
    if (!uniSavePill) return;
    uniSavePill.textContent = text;
    uniSavePill.classList.add('is-visible');
    clearTimeout(uniSaveTimer);
    uniSaveTimer = setTimeout(() => uniSavePill.classList.remove('is-visible'), 2200);
  };

  const getStoreForType = (type) => {
    if (type === 'news') return newsState;
    if (type === 'ad') return adsState;
    if (type === 'column') return columnsState;
    if (type === 'staff') return staffState.members;
    return [];
  };

  const renderQuickArtChips = () => {
    const row = $('#uni-quick-art-row');
    const previewWrap = $('#uni-photo-preview-wrap');
    const previewImg = $('#uni-photo-preview-img');
    const clearBtn = $('#uni-clear-photo-btn');
    if (!row) return;
    row.innerHTML = '';

    if (currentUniType === 'staff' && currentEditingId !== 'staff-intro') {
      row.hidden = false;
      LSN_SKINS.forEach(s => {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'uni-art-chip' + (!currentPhotoData && currentArtPreset === s.id ? ' is-selected' : '');
        chip.textContent = s.label;
        chip.addEventListener('click', () => {
          currentArtPreset = s.id;
          currentPhotoData = '';
          renderQuickArtChips();
        });
        row.appendChild(chip);
      });
    } else {
      row.hidden = true;
    }

    if (previewWrap && previewImg) {
      if (currentPhotoData) {
        previewImg.src = currentPhotoData;
        previewWrap.hidden = false;
        if (clearBtn) clearBtn.hidden = false;
      } else {
        previewImg.removeAttribute('src');
        previewWrap.hidden = true;
        if (clearBtn) clearBtn.hidden = true;
      }
    }
    if (typeof renderStaffSkinPicker === 'function') renderStaffSkinPicker();
  };

  let currentListStatusFilter = 'all';

  const updateCabinetLivePreview = () => {
    const titleVal = ($('#uni-field-title')?.value || '').trim() || 'Заголовок публикации';
    const bodyVal = ($('#uni-field-body')?.value || '').trim();
    const titleEl = $('#uni-live-preview-title');
    const leadEl = $('#uni-live-preview-lead');
    if (titleEl) titleEl.textContent = titleVal;
    if (leadEl) {
      const firstP = bodyVal.split(/\n\s*\n/)[0] || '';
      leadEl.textContent = firstP ? (firstP.length > 180 ? firstP.slice(0, 180) + '…' : firstP) : 'Текст вводного абзаца будет отображаться здесь...';
    }
  };

  const renderUniItemsList = () => {
    const roleInfo = getUserRoleInfo(currentUser);
    const canCreateCurrent = canCreateEditorialType(currentUniType, roleInfo);
    const canManageCurrent = currentUniType === 'news' ? roleInfo.canEditAll
      : currentUniType === 'ad' ? roleInfo.canManageAds
