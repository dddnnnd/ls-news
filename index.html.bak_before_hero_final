  // Helper for generating custom kebab-case URL slugs from Cyrillic/Latin titles
  const generateSlugFromTitle = (title) => {
    if (!title) return "";
    const cyrMap = {
      "а": "a", "б": "b", "в": "v", "г": "g", "д": "d", "е": "e", "ё": "yo", "ж": "zh",
      "з": "z", "и": "i", "й": "y", "к": "k", "л": "l", "м": "m", "н": "n", "о": "o",
      "п": "p", "р": "r", "с": "s", "т": "t", "у": "u", "ф": "f", "х": "kh", "ц": "ts",
      "ч": "ch", "ш": "sh", "щ": "shch", "ъ": "", "ы": "y", "ь": "", "э": "e", "ю": "yu", "я": "ya"
    };
    let clean = String(title).trim().toLowerCase();
    let result = "";
    for (let i = 0; i < clean.length; i++) {
      const ch = clean[i];
      if (cyrMap[ch] !== undefined) {
        result += cyrMap[ch];
      } else if (/[a-z0-9]/.test(ch)) {
        result += ch;
      } else if (/[\s\-_—–.,:;!?/\\]/.test(ch)) {
        if (result.length && result[result.length - 1] !== "-") {
          result += "-";
        }
      }
    }
    return result.replace(/^-+|-+$/g, "").slice(0, 80);
  };
  window.generateSlugFromTitle = generateSlugFromTitle;

