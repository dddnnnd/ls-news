  // Change in-game nickname (allowed once per 10 days)
  $('#change-nick-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!currentUser) return;

    const remaining = getNickCooldownRemainingMs(currentUser);
    if (remaining > 0) {
      alert(`🔒 Смена ника разрешена раз в 10 дней! Следующая смена будет доступна через ${formatNickRemainingTime(remaining)}.`);
      return;
    }

    const inputVal = ($('#change-nick-input').value || '').trim();
    const cleanNick = inputVal.replace(/_/g, ' ').replace(/\s+/g, ' ').trim();

    if (!/^[A-Za-zА-Яа-яЁё]+ [A-Za-zА-Яа-яЁё]+$/.test(cleanNick) || cleanNick.length < 5 || cleanNick.length > 60) {
      alert('Никнейм должен быть строго в формате «Имя Фамилия».');
      return;
    }
    if (cleanNick.length > 30) {
      alert('Никнейм не должен превышать 30 символов.');
      return;
    }
    if (cleanNick.toLowerCase() === (currentUser.username || '').toLowerCase()) {
      alert('Новый никнейм совпадает с вашим текущим никнеймом.');
      return;
    }

    const taken = usersDb.some(u =>
      (u.id !== currentUser.id) &&
      (u.username && u.username.toLowerCase() === cleanNick.toLowerCase())
    );
    if (taken) {
      alert(`Никнейм "${cleanNick}" уже занят другим пользователем.`);
      return;
    }

    const oldNick = currentUser.username;
    const now = Date.now();

    if (!sb || !currentUser.uuid) {
      alert('⚠️ Не удалось подтвердить сессию Supabase. Войдите заново.');
      return;
    }

    try {
      const { data: existing, error: existingError } = await sb
        .from('lsn_public_profiles')
        .select('id')
        .ilike('username', cleanNick)
        .neq('id', currentUser.uuid)
        .maybeSingle();
      if (existingError) throw existingError;
      if (existing) {
        alert(`Никнейм «${cleanNick}» уже занят другим пользователем.`);
        return;
      }

      const { error: updateError } = await sb
        .from('profiles')
        .update({ username: cleanNick, updated_at: new Date(now).toISOString() })
        .eq('id', currentUser.uuid);
      if (updateError) throw updateError;

      currentUser.username = cleanNick;
      currentUser.fullName = cleanNick;
      currentUser.lastNickChange = now;
      newsState.forEach(n => {
        if (n.authorLogin && n.authorLogin.toLowerCase() === oldNick.toLowerCase()) n.authorLogin = cleanNick;
        if (n.author && n.author.toLowerCase() === oldNick.toLowerCase()) n.author = cleanNick;
      });
      adsState.forEach(n => { if (n.authorLogin && n.authorLogin.toLowerCase() === oldNick.toLowerCase()) n.authorLogin = cleanNick; });
      columnsState.forEach(n => { if (n.authorLogin && n.authorLogin.toLowerCase() === oldNick.toLowerCase()) n.authorLogin = cleanNick; });
      staffState.members.forEach(m => { if (m.login && m.login.toLowerCase() === oldNick.toLowerCase()) m.login = cleanNick; });
      localStorage.setItem(NEWS_KEY, JSON.stringify(newsState));
      localStorage.setItem(ADS_KEY, JSON.stringify(adsState));
      localStorage.setItem(COLUMNS_KEY, JSON.stringify(columnsState));
      localStorage.setItem(STAFF_KEY, JSON.stringify(staffState));
