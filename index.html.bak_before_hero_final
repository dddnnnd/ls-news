        '<div style="font-size:15px; font-weight:600; color:#e2e8f0;">В архиве пусто</div>' +
        '<div style="font-size:13px; margin-top:4px;">Снятые с публикации материалы и объявления сохраняются здесь и могут быть восстановлены в 1 клик.</div>' +
      '</div>';
      return;
    }

    const typeLabels = {
      ad: 'Реклама / Объявление',
      news: 'Новость',
      column: 'Колонка',
      staff: 'Досье / Состав'
    };
    const typeBadges = {
      ad: 'background:#059669; color:#fff;',
      news: 'background:#2563eb; color:#fff;',
      column: 'background:#d97706; color:#fff;',
      staff: 'background:#7c3aed; color:#fff;'
    };

    listEl.innerHTML = filtered.map(item => {
      const type = item.actType || 'news';
      const label = typeLabels[type] || 'Материал';
      const badgeStyle = typeBadges[type] || 'background:#475569; color:#fff;';
