  $('#btn-forgot-password')?.addEventListener('click', async () => {
    const ident = ($('#login-identifier')?.value || '').trim();
    const msg = $('#auth-message');
    if (!ident) {
      if (msg) msg.textContent = 'ℹ️ Введите никнейм или email в поле выше и нажмите «Забыли пароль?».';
      $('#login-identifier')?.focus();
      return;
    }
    if (!sb) {
      if (msg) msg.textContent = '⚠️ Supabase сейчас недоступен. Попробуйте позже.';
      return;
    }
    if (msg) msg.textContent = 'Отправка запроса на сброс пароля…';
    try {
      await sb.functions.invoke('username-password-reset', {
        body: { username: ident, email: ident, redirectTo: window.location.origin + window.location.pathname }
      });
      if (msg) msg.textContent = '✉️ Если аккаунт существует, инструкция по сбросу отправлена на привязанную почту.';
    } catch (err) {
      console.warn('Password reset request error:', err);
      if (msg) msg.textContent = '✉️ Если аккаунт существует, инструкция по сбросу отправлена на привязанную почту.';
