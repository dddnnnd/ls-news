      card.innerHTML = `
        <div style="display:flex; align-items:flex-start;">
          ${thumbHtml}
          <div style="flex:1; min-width:0;">
            ${statusHtml}
            ${authorBadge}
            <div class="cab-ad-item__title"${colorStyle}>${titleText}</div>
          </div>
        </div>
        ${actionsHtml}
      `;
      listEl.appendChild(card);
    });
  };

  const loadItemIntoUniFormBase = (itemId) => {
    const formTitle = $('#uni-form-title');
    const delBtn = $('#uni-delete-current-btn');
    const fileInput = $('#uni-field-file');
    if (fileInput) fileInput.value = '';

    const lblTitle = $('#uni-label-title');
    const lblSub = $('#uni-label-sub');
    const lblBody = $('#uni-label-body');

    if (itemId === 'hero-focus' || currentUniType === 'focus') {
      const roleInfo = getUserRoleInfo(currentUser);
      if (roleInfo.rank < 3) {
        flashUniSaved('🔒 Редактирование главного промо-блока доступно только Руководству редакции.');
        return;
      }
      currentEditingId = 'hero-focus';
      if (formTitle) formTitle.textContent = 'Редактирование блока «LSN В ФОКУСЕ»';
      lblTitle.textContent = 'Заголовок промо-блока';
      lblSub.textContent = 'Рубрика / Бейдж (Kicker)';
      lblBody.textContent = 'Описание блока (2–4 строки на главной + полный текст при открытии)';
      $('#uni-item-id').value = 'hero-focus';
      $('#uni-field-title').value = heroFocusState.title || '';
      $('#uni-field-sub').value = heroFocusState.kicker || 'LSN В ФОКУСЕ · СПЕЦРЕПОРТАЖ';
      $('#uni-field-body').value = [heroFocusState.lead, heroFocusState.body].filter(Boolean).join('\n\n') || heroFocusState.description || '';
      currentPhotoData = heroFocusState.noPhoto ? '' : (heroFocusState.img || '');
      currentArtPreset = '';
      if (delBtn) delBtn.hidden = true;
