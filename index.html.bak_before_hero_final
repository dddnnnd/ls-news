/* 7. Interactive Pointer Spotlight Effect (interactive-content-reveal) */
.v6-skyline__card,
.editorial-quote,
.v6-cta,
.news-empty-state {
  position: relative;
  overflow: hidden;
}
.v6-skyline__card::before,
.editorial-quote::before,
.v6-cta::before,
.news-empty-state::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: radial-gradient(
    420px circle at var(--spot-x, 50%) var(--spot-y, 50%),
    rgba(255, 183, 3, 0.12),
    transparent 65%
  );
  opacity: 0;
  transition: opacity 0.3s ease;
}
.v6-skyline__card:hover::before,
.editorial-quote:hover::before,
.v6-cta:hover::before,
.news-empty-state:hover::before {
