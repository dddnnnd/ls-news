      }
      if (trimmed.startsWith('[Справка:') || trimmed.startsWith('[Важно:')) {
        const endBracket = trimmed.indexOf(']');
        const tagTitle = endBracket !== -1 ? trimmed.slice(1, endBracket) : 'Справка';
