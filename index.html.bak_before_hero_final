    const items = getStoreForType(currentUniType);
    const item = items.find(x => x.id === itemId);

    if (currentUniType === 'staff') {
      lblTitle.textContent = 'Имя и Фамилия';
      lblSub.textContent = 'Должность';
      lblBody.textContent = 'Биография / Досье';
    } else {
      lblTitle.textContent = 'Заголовок';
      lblSub.textContent = 'Рубрика / Тег';
      lblBody.textContent = 'Текст публикации';
    }

    if (!item) {
      currentEditingId = ['news', 'ad', 'column'].includes(currentUniType)
        ? createArticleUuid()
        : currentUniType + '-' + Date.now();
      if (formTitle) formTitle.textContent = currentUniType === 'staff' ? (getUserRoleInfo(currentUser).level === 'journalist' ? 'Моё досье' : 'Новый сотрудник') : 'Новая публикация';
      $('#uni-item-id').value = currentEditingId;
      $('#uni-field-title').value = '';
      $('#uni-field-sub').value = '';
      $('#uni-field-body').value = '';
      currentPhotoData = '';
      currentArtPreset = currentUniType === 'staff' ? 'skin_director' : '';
      if (delBtn) delBtn.hidden = true;
      renderQuickArtChips();
      if (typeof updateMediaUI === 'function') updateMediaUI();
      renderUniItemsList();
      return;
    }

    if (!canUserEditItem(item)) {
      if (currentUniType === 'news' && getUserRoleInfo(currentUser).level === 'journalist') {
        flashUniSaved('🔒 Журналист может редактировать только собственные черновики.');
      } else if (currentUniType === 'staff' && getUserRoleInfo(currentUser).level === 'journalist' && !isOwnStaffDossier(item, currentUser)) {
        flashUniSaved('🔒 Можно редактировать только своё досье.');
      } else {
        flashUniSaved('🔒 У этой роли нет права редактировать этот материал.');
      }
      return;
    }
    currentEditingId = item.id;
    if (formTitle) formTitle.textContent = 'Редактирование';
    $('#uni-item-id').value = item.id;
    $('#uni-field-title').value = (item.title || item.name || '').replace(/\n/g, ' ');
    $('#uni-field-sub').value = item.category || item.tag || item.subtitle || item.role || '';
    $('#uni-field-body').value = item.body || item.fullText || item.bio || '';
    currentPhotoData = item.img || item.customImg || '';
    currentArtPreset = item.skinId || '';
    if (delBtn) delBtn.hidden = !canUserDeleteItem(item);
    renderQuickArtChips();
    if (typeof updateMediaUI === 'function') updateMediaUI();
    renderUniItemsList();
  };

  let currentTitleColor = '';
  const updateColorUI = () => {
    const preview = $('#uni-color-preview');
    if (preview) {
      preview.textContent = ($('#uni-field-title')?.value || '').trim() || 'Текст заголовка';
      preview.style.color = currentTitleColor || '#f8fafc';
    }
    const active = (currentTitleColor || '#f8fafc').toLowerCase();
    $$('.uni-color-swatch').forEach(s => s.classList.toggle('is-selected', (s.dataset.color || '').toLowerCase() === active));
    const picker = $('#uni-field-color');
    if (picker && currentTitleColor) picker.value = currentTitleColor;
  };

  const syncUniExtraFields = () => {
    const items = getStoreForType(currentUniType);
    const item = items.find(x => x.id === currentEditingId);
    const newsOpts = $('#uni-news-options');
    const adOpts = $('#uni-ad-options');
    const statsOpts = $('#uni-staff-stats-options');
    const focusOpts = $('#uni-focus-extra-options');
    const staffStatusOpts = $('#uni-staff-status-options');
    const colorLabel = $('#uni-color-label');
    if (newsOpts) {
      newsOpts.hidden = currentUniType !== 'news';
      newsOpts.style.display = currentUniType === 'news' ? 'flex' : 'none';
    }
    if (adOpts) adOpts.hidden = !(currentUniType === 'ad' || currentUniType === 'column');
    const isHeroFocus = (currentEditingId === 'hero-focus' || currentUniType === 'focus');
    if (focusOpts) {
      focusOpts.hidden = !isHeroFocus;
      if (isHeroFocus) {
        const fTag = $('#uni-focus-tag');
        const fCtaText = $('#uni-focus-cta-text');
        const fCtaLink = $('#uni-focus-cta-link');
        const fCap = $('#uni-focus-caption');
        if (fTag) fTag.value = heroFocusState.tag || '';
        if (fCtaText) fCtaText.value = heroFocusState.ctaText || '';
        if (fCtaLink) fCtaLink.value = heroFocusState.ctaUrl || '';
        if (fCap) fCap.value = heroFocusState.caption || '';
      }
    }
    const isStaffIntro = (currentUniType === 'staff' && currentEditingId === 'staff-intro');
    const isStaffMember = (currentUniType === 'staff' && !isStaffIntro && !isHeroFocus);
    if (staffStatusOpts) {
      staffStatusOpts.hidden = !isStaffMember;
      if (isStaffMember) {
        const badgeInput = $('#uni-staff-badge-input');
        const currentBadge = (item && item.badge) || 'В РЕДАКЦИИ';
        if (badgeInput) badgeInput.value = currentBadge;
        $$('#uni-staff-status-chips [data-staff-status-preset]').forEach(chip => {
          chip.classList.toggle('is-selected', (chip.dataset.staffStatusPreset || '').toUpperCase() === currentBadge.toUpperCase());
        });
      }
    }
    if (statsOpts) {
      statsOpts.hidden = !isStaffIntro;
      if (isStaffIntro && Array.isArray(staffState.stats)) {
        for (let i = 0; i < 4; i++) {
          const st = staffState.stats[i] || DEFAULT_STAFF_STATS[i];
          const tEl = $(`#uni-stat-tag-${i}`);
          const vEl = $(`#uni-stat-val-${i}`);
          const dEl = $(`#uni-stat-desc-${i}`);
          if (tEl) tEl.value = st.tag || '';
          if (vEl) vEl.value = st.value || '';
          if (dEl) dEl.value = st.desc || '';
        }
      }
    }
    if (colorLabel) {
      colorLabel.textContent = currentUniType === 'column' ? 'Цвет заголовка колонки' : 'Цвет заголовка объявления';
    }
    const imp = $('#uni-field-important');
    if (imp) imp.checked = !!(item && item.important);
    currentTitleColor = (item && item.titleColor) || '';
    updateColorUI();
  };

  const loadItemIntoUniForm = (itemId) => {
    loadItemIntoUniFormBase(itemId);
    syncUniExtraFields();
  };

  // =========================================================================
  // RBAC PERMISSIONS ROSTER CONTROLLER & EDITORIAL PROFILE CENTER
  // =========================================================================
  let permCurrentFilter = 'all';

  const assignUserRole = async (targetIdOrUsername, newLvl) => {
    const actorRole = getUserRoleInfo(currentUser);
    if (!actorRole.canManageRoles) return false;
    const targetUser = (usersDb || []).find(x =>
      (x.id && String(x.id).toLowerCase() === String(targetIdOrUsername).toLowerCase()) ||
      (x.username && String(x.username).toLowerCase() === String(targetIdOrUsername).toLowerCase())
    );
    if (!targetUser) return false;
    if (!canUserManageTargetUser(currentUser, targetUser)) {
      alert('🔒 Запрещено: вы не можете изменить роль этому пользователю или самому себе.');
      return false;
    }
    const newRoleInfo = ROLE_HIERARCHY[newLvl];
    if (!newRoleInfo || newRoleInfo.level === 'admin' || newRoleInfo.rank >= actorRole.rank) {
      alert('🔒 Можно назначать только роли ниже собственной.');
      return false;
    }
    targetUser.role = newLvl;
    targetUser.roleTitle = newRoleInfo.title;

    const activeSb = window.sb || sb;
    const userUuid = targetUser.uuid || (targetUser.id && /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(targetUser.id) ? targetUser.id : null);
    if (activeSb && userUuid) {
      try {
        const { error: rpcErr } = await activeSb.rpc('lsn_set_user_role', {
          p_user_id: userUuid,
          p_new_role: newLvl
        });
        if (rpcErr) {
          console.error('Supabase role update error:', rpcErr);
          await loadAdminProfiles();
          renderPermissionsList();
          alert('⚠️ Роль не сохранена в базе Supabase: ' + (rpcErr.message || 'сервер отклонил операцию'));
          return false;
        }
      } catch (err) {
        console.error('Supabase role update network error:', err);
      }
    }
    renderPermissionsList();
    flashUniSaved(`Роль ${escapeHtml(targetUser.username)} обновлена на «${escapeHtml(newRoleInfo.title)}»`);
    return true;
  };

  const revokeUserRole = async (targetIdOrUsername) => {
    return assignUserRole(targetIdOrUsername, 'user');
  };

  const openUserProfileCenter = (targetUser) => {
    if (!targetUser) return;
    const dialog = $('#profile-center-dialog');
    if (!dialog) return;

    // Zero-modal conflict: ensure cabinet dialog is closed
    const cabinetDialog = $('#cabinet-dialog');
    if (cabinetDialog && cabinetDialog.open) cabinetDialog.close();

    const uRole = getUserRoleInfo(targetUser);
    const actorRole = getUserRoleInfo(currentUser);
    const canManageThis = canUserManageTargetUser(currentUser, targetUser);
    const isMe = currentUser && (
      (currentUser.id && targetUser.id && currentUser.id === targetUser.id) ||
      (currentUser.username && targetUser.username && currentUser.username.toLowerCase() === targetUser.username.toLowerCase())
    );

    // Find staff profile
    const staffDossier = getCurrentUserStaffDossier(targetUser);

    // Header
    const avatarEl = $('#pc-header-avatar');
    if (avatarEl) avatarEl.textContent = (targetUser.username || 'U').charAt(0).toUpperCase();

    const titleEl = $('#profile-center-title');
    if (titleEl) titleEl.textContent = targetUser.username || 'Пользователь';

    const badgeEl = $('#pc-header-badge');
    if (badgeEl) {
      badgeEl.className = 'role-badge ' + (uRole.badgeClass || 'role-badge--reader');
      badgeEl.textContent = uRole.title || 'Читатель';
    }

    const statusEl = $('#pc-header-status');
    if (statusEl) {
      if (staffDossier) {
        statusEl.style.display = 'inline-block';
        statusEl.style.background = 'rgba(34,197,94,0.15)';
        statusEl.style.color = '#4ade80';
        statusEl.textContent = '🟢 В штате (Есть анкета)';
      } else if (uRole.rank >= 2) {
        statusEl.style.display = 'inline-block';
        statusEl.style.background = 'rgba(234,179,8,0.15)';
        statusEl.style.color = '#fbbf24';
        statusEl.textContent = '🟡 Сотрудник без анкеты';
      } else {
        statusEl.style.display = 'inline-block';
        statusEl.style.background = 'rgba(148,163,184,0.15)';
        statusEl.style.color = '#94a3b8';
        statusEl.textContent = '⚪ Читатель портала';
      }
    }

    const subEl = $('#pc-header-sub');
    if (subEl) subEl.textContent = targetUser.fullName || targetUser.username || 'Los Santos News';

    // Card 1: Account
    const cUsername = $('#pc-card-username');
    if (cUsername) cUsername.textContent = targetUser.username || '-';

    const cRegdate = $('#pc-card-regdate');
    if (cRegdate) cRegdate.textContent = targetUser.created_at ? new Date(targetUser.created_at).toLocaleDateString('ru-RU') : 'Ранее зарегистрирован';

    const cRank = $('#pc-card-rank');
    if (cRank) cRank.textContent = `${uRole.title} [Ранг: ${uRole.rank}]`;

    // Card 2: Staff Profile Dossier
    const staffContent = $('#pc-staff-content');
    if (staffContent) {
      if (staffDossier) {
        const canEditDossier = canUserEditItem(staffDossier);
        const canDeleteDossier = canUserDeleteItem(staffDossier); // Admin only!
        staffContent.innerHTML = `
          <div style="display:flex; flex-direction:column; gap:6px;">
            <div><span style="color:#64748b;">Должность в анкете:</span> <strong style="color:#fff;">${escapeHtml(staffDossier.role || '-')}</strong></div>
            <div><span style="color:#64748b;">Имя в анкете:</span> <strong style="color:#fff;">${escapeHtml(staffDossier.name || '-')}</strong></div>
            ${staffDossier.bio ? `<div><span style="color:#64748b;">О себе / Биография:</span> <p style="margin:4px 0 0; color:#94a3b8; font-size:12px; font-style:italic;">${escapeHtml(staffDossier.bio)}</p></div>` : ''}
            <div style="display:flex; gap:8px; margin-top:8px; flex-wrap:wrap;">
              ${canEditDossier ? `<button type="button" class="cab-ad-mini-btn" id="pc-btn-edit-dossier" style="background:#0284c7; color:#fff; border:none; padding:5px 12px; border-radius:6px; font-size:12px; cursor:pointer;">✏️ Редактировать анкету</button>` : ''}
              ${canDeleteDossier ? `<button type="button" class="cab-ad-mini-btn cab-ad-mini-btn--del" id="pc-btn-del-dossier" style="background:#dc2626; color:#fff; border:none; padding:5px 12px; border-radius:6px; font-size:12px; cursor:pointer;">🗑️ Удалить анкету</button>` : ''}
            </div>
          </div>
        `;
        $('#pc-btn-edit-dossier')?.addEventListener('click', () => {
          dialog.close();
          openJournalistCabinet('staff', staffDossier.id);
        });
        $('#pc-btn-del-dossier')?.addEventListener('click', async () => {
          if (confirm(`Удалить анкету сотрудника ${staffDossier.name}? (Учётная запись пользователя сохранится)`)) {
            dialog.close();
            await deleteUniItemById(staffDossier.id);
          }
        });
      } else {
        const canCreateForThis = (actorRole.level === 'admin') || (isMe && actorRole.rank >= 2);
        const buttonText = actorRole.level === 'admin'
          ? `+ Создать анкету для ${escapeHtml(targetUser.username)}`
          : '+ Создать анкету';
        staffContent.innerHTML = `
          <div style="color:#94a3b8; font-size:12.5px;">
            <p style="margin:0 0 8px 0;">Анкета сотрудника редакции отсутствует.</p>
            ${canCreateForThis ? `<button type="button" class="cab-ad-mini-btn" id="pc-btn-create-dossier" style="background:#059669; color:#fff; border:none; padding:6px 14px; border-radius:8px; font-size:12px; font-weight:700; cursor:pointer;">${buttonText}</button>` : ''}
          </div>
        `;
        $('#pc-btn-create-dossier')?.addEventListener('click', () => {
          dialog.close();
          openJournalistCabinet('staff');
          loadItemIntoUniForm(null);
          const fTitle = $('#uni-field-title');
          const fSub = $('#uni-field-sub');
          if (fTitle) fTitle.value = targetUser.fullName || targetUser.username || '';
          if (fSub) fSub.value = uRole.title || 'Сотрудник LSN';
          const authorIdInput = $('#uni-staff-author-id');
          const authorLoginInput = $('#uni-staff-author-login');
          if (authorIdInput) authorIdInput.value = targetUser.uuid || targetUser.id || '';
          if (authorLoginInput) authorLoginInput.value = targetUser.username || '';
          const targetPill = $('#uni-staff-target-pill');
          if (targetPill) {
            targetPill.textContent = `🎯 Создание анкеты для сотрудника: ${targetUser.username} [${uRole.title}]`;
            targetPill.hidden = false;
          }
        });
      }
    }

    // Card 3: Authored Materials
    const matContent = $('#pc-materials-content');
    if (matContent) {
      const uLogin = (targetUser.username || '').toLowerCase();
      const uId = String(targetUser.id || targetUser.uuid || '');
      const authoredNews = (newsState || []).filter(n => {
        const aLogin = String(n.authorLogin || n.author || '').toLowerCase();
        const aId = String(n.author_id || '');
        return (uId && aId && uId === aId) || (uLogin && aLogin && aLogin.includes(uLogin));
      });
      if (authoredNews.length === 0) {
        matContent.innerHTML = '<span style="color:#64748b; font-size:12px;">Публикаций в эфире нет.</span>';
      } else {
        matContent.innerHTML = `<ul style="margin:0; padding-left:18px; font-size:12px; display:flex; flex-direction:column; gap:4px;">` +
          authoredNews.map(n => `<li style="color:#e2e8f0;"><span style="color:#a78bfa;">[${n.status || 'published'}]</span> ${escapeHtml(n.title || 'Без названия')} <span style="color:#64748b;">(${new Date(n.createdAt || Date.now()).toLocaleDateString('ru-RU')})</span></li>`).join('') +
          `</ul>`;
      }
    }

    // Card 4: Role Management
    const roleContent = $('#pc-role-content');
    if (roleContent) {
      if (isMe) {
        roleContent.innerHTML = `<span style="color:#38bdf8; font-size:12px;">🔒 Ваш аккаунт (самовыдача и изменение роли отключены).</span>`;
      } else if (canManageThis) {
        const allowedAssignable = getAllowedAssignableRoles(currentUser);
        const options = allowedAssignable.map(opt =>
          `<option value="${opt.level}"${uRole.level === opt.level ? ' selected' : ''}>${opt.title}</option>`
        ).join('');
        roleContent.innerHTML = `
          <div style="display:flex; flex-direction:column; gap:8px;">
            <label style="font-size:12px; color:#64748b;">Назначить новую должность:</label>
            <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
              <select id="pc-select-role" style="background:#1e293b; color:#fff; border:1px solid rgba(255,255,255,0.15); border-radius:6px; padding:6px 10px; font-size:12px;">
                ${options}
              </select>
              <button type="button" class="cab-ad-mini-btn" id="pc-btn-save-role" style="background:#0ea5e9; color:#fff; border:none; padding:6px 12px; border-radius:6px; font-size:12px; cursor:pointer;">Сохранить роль</button>
            </div>
            ${uRole.rank >= 2 ? `<button type="button" class="cab-ad-mini-btn cab-ad-mini-btn--del" id="pc-btn-revoke-role" style="margin-top:6px; align-self:flex-start;">Снять полномочия до читателя</button>` : ''}
          </div>
        `;
        $('#pc-btn-save-role')?.addEventListener('click', async () => {
          const newRole = $('#pc-select-role')?.value;
          if (!newRole) return;
          if (confirm(`Назначить пользователю ${targetUser.username} роль «${newRole}»?`)) {
            await assignUserRole(targetUser.id || targetUser.username, newRole);
            dialog.close();
            renderPermissionsList();
          }
        });
        $('#pc-btn-revoke-role')?.addEventListener('click', async () => {
          if (confirm(`Отозвать полномочия у ${targetUser.username} и перевести в читатели?`)) {
            await revokeUserRole(targetUser.id || targetUser.username);
            dialog.close();
            renderPermissionsList();
          }
        });
      } else {
        roleContent.innerHTML = `<span style="color:#64748b; font-size:12px;">(Ранг пользователя равен или выше вашего — управление недоступно)</span>`;
      }
    }

    // Close handlers
    const closeBtn = $('#profile-center-close-btn');
    if (closeBtn) closeBtn.onclick = () => dialog.close();
    const closeBtnFooter = $('#pc-close-btn');
    if (closeBtnFooter) closeBtnFooter.onclick = () => dialog.close();
    dialog.onclick = (e) => {
      if (e.target === dialog) dialog.close();
    };

    if (!dialog.open) dialog.showModal();
  };

  const renderPermissionsList = () => {
    const matrix = $('#lsn-rbac-matrix-body');
    if (matrix) {
      const ok = v => v ? '✓' : '—';
      matrix.innerHTML = Object.values(ROLE_HIERARCHY).sort((a,b)=>b.rank-a.rank).map(r => `<tr>
        <td style="padding:9px 10px;color:#fff;font-weight:800;border-top:1px solid rgba(255,255,255,.06);">${escapeHtml(r.title)} <span style="color:#64748b;font-weight:600;">[${r.rank}]</span></td>
        <td style="text-align:center;border-top:1px solid rgba(255,255,255,.06);">${ok(r.canCreateNews)}</td>
        <td style="text-align:center;border-top:1px solid rgba(255,255,255,.06);">${ok(r.canPublish)}</td>
        <td style="text-align:center;border-top:1px solid rgba(255,255,255,.06);">${ok(r.canManageAds)}</td>
        <td style="text-align:center;border-top:1px solid rgba(255,255,255,.06);">${ok(r.canManageColumns)}</td>
        <td style="text-align:center;border-top:1px solid rgba(255,255,255,.06);">${ok(r.canManageStaff)}</td>
        <td style="text-align:center;border-top:1px solid rgba(255,255,255,.06);">${ok(r.canManageRoles)}</td>
        <td style="text-align:center;border-top:1px solid rgba(255,255,255,.06);">${ok(r.canManageUsers)}</td>
        <td style="text-align:center;border-top:1px solid rgba(255,255,255,.06);">${ok(r.canEditRating)}</td>
      </tr>`).join('');
    }
    const listEl = $('#uni-journalists-list');
    const addForm = $('#uni-add-journalist-form');
    const notice = $('#uni-perm-readonly-notice');
    const roleInfo = getUserRoleInfo(currentUser);
    if (!roleInfo.canManageRoles) {
      const ws = $('#uni-permissions-workspace');
      if (ws) ws.hidden = true;
      return;
    }
    const selectRegUser = $('#uni-select-registered-user');
    const selectRoleLevel = $('#uni-new-journalist-level');

    if (notice) notice.hidden = roleInfo.canManageRoles;
    if (addForm) { addForm.hidden = true; addForm.style.display = 'none'; }

    $$('#uni-perm-role-filters .my-act-filter-btn').forEach(btn => {
      btn.classList.toggle('is-active', btn.dataset.permFilter === permCurrentFilter);
    });

    if (!listEl) return;
    listEl.innerHTML = '';

    const searchInput = $('#uni-perm-search');
    const query = (searchInput?.value || '').trim().toLowerCase();

    // Get visible users according to hierarchy:
    // - Admin sees all
    // - Leader sees leader, deputy, journalist, reader (Admins hidden)
    // - Deputy sees deputy, journalist, reader (Admins and Leader hidden)
    let visibleUsers = getVisibleUsersForActor(currentUser);
    if (query) {
      visibleUsers = visibleUsers.filter(u => matchUser(u, query));
    }
    if (permCurrentFilter !== 'all') {
      visibleUsers = visibleUsers.filter(u => {
        const r = getUserRoleInfo(u);
        if (permCurrentFilter === 'admin') return r.level === 'admin';
        if (permCurrentFilter === 'management') return r.rank === 4 || r.rank === 3;
        if (permCurrentFilter === 'journalist') return r.rank === 2;
        if (permCurrentFilter === 'user') return r.rank === 1;
        return true;
      });
    }
    if (visibleUsers.length === 0) {
      listEl.innerHTML = `<div style="padding:24px; text-align:center; color:#94a3b8; font-size:13px;">${query ? `🔍 Пользователи по запросу «${escapeHtml(query)}» не найдены.` : 'В базе нет зарегистрированных пользователей.'}</div>`;
      return;
    }
    const allowedAssignable = getAllowedAssignableRoles(currentUser);

    // Update the dropdown for role level in the form
    if (selectRoleLevel) {
      selectRoleLevel.innerHTML = allowedAssignable.map(r =>
        `<option value="${r.level}">${r.title}</option>`
      ).join('');
    }

    // Update the dropdown of registered site users
    if (selectRegUser) {
      const eligibleUsers = visibleUsers.filter(u => canUserManageTargetUser(currentUser, u));
      selectRegUser.innerHTML = '<option value="">-- Выбрать из зарегистрированных пользователей --</option>' +
        eligibleUsers.map(u => {
          const uRole = getUserRoleInfo(u);
          return `<option value="${escapeHtml(u.username)}">${escapeHtml(u.username)} (Текущая роль: ${escapeHtml(uRole.title)})</option>`;
        }).join('');
    }

    visibleUsers.forEach((u) => {
      const card = document.createElement('div');
      card.className = 'cab-ad-item';
      const uRole = getUserRoleInfo(u);
      const isMe = (currentUser && (
        (currentUser.id && u.id && currentUser.id === u.id) ||
        (currentUser.username && u.username && currentUser.username.toLowerCase() === u.username.toLowerCase())
      ));
      const canManageThis = canUserManageTargetUser(currentUser, u);

      let actionsHtml = '';
      if (isMe) {
        actionsHtml = `
          <div style="display:flex; align-items:center; gap:8px; margin-top:8px;">
            <span style="font-size:12px; color:#38bdf8; padding:4px 10px; border-radius:6px; background:rgba(56,189,248,0.1); border:1px solid rgba(56,189,248,0.25);">
              🔒 Ваш аккаунт (самовыдача и изменение роли отключены)
            </span>
          </div>
        `;
      } else if (canManageThis) {
        // Allowed roles to assign must be strictly below current actor's rank
        const roleOptions = allowedAssignable.map(opt =>
          `<option value="${opt.level}"${uRole.level === opt.level ? ' selected' : ''}>${opt.title}</option>`
        ).join('');

        const selectOptions = uRole.rank <= 1
          ? '<option value="" selected>-- Назначить должность --</option>' + roleOptions
          : '<option value="">-- Сменить должность --</option>' + roleOptions;

        actionsHtml = `
          <div style="display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-top:8px;">
            <select class="cab-ad-mini-btn" data-change-role="${escapeHtml(u.id || u.username)}" style="background:#131822; color:#fff; border:1px solid rgba(255,255,255,0.15); border-radius:6px; padding:4px 8px; font-size:12px;">
              ${selectOptions}
            </select>
            ${uRole.rank >= 2 ? `<button type="button" class="cab-ad-mini-btn cab-ad-mini-btn--del" data-revoke-login="${escapeHtml(u.id || u.username)}">Снять роль</button>` : ''}
            ${getUserRoleInfo(currentUser).canDeleteUsers && uRole.level !== 'admin' ? `<button type="button" class="cab-ad-mini-btn cab-ad-mini-btn--del" data-delete-account="${escapeHtml(u.id || u.username)}">Удалить аккаунт</button>` : ''}
          </div>
        `;
      } else {
        actionsHtml = `
          <div style="display:flex; align-items:center; gap:8px; margin-top:6px;">
            <span style="font-size:11.5px; color:#94a3b8;">(Руководящий ранг · просмотр)</span>
          </div>
        `;
      }

      const metaSubtitle = [
        escapeHtml(u.fullName || u.username),
        u.id ? `ID: ${escapeHtml(String(u.id).slice(0, 8))}…` : '',
        u.created_at ? `Регистрация: ${new Date(u.created_at).toLocaleDateString('ru-RU')}` : ''
      ].filter(Boolean).join(' · ');

      card.innerHTML = `
