          .from('lsn_articles')
          .select('*')
          .or('status.eq.archived,and(status.eq.draft,metadata->>archived.eq.true)')
          .order('updated_at', { ascending: false });

        if (!error && Array.isArray(data)) {
          data.forEach(row => {
            const actType = row.type || 'news';
            const exists = items.some(x => x.id === row.id);
            if (!exists) {
              items.push({
                id: row.id,
                actType: actType,
              title: row.title || 'Без названия',
                category: row.category || '',
                tag: row.category || '',
                subtitle: row.category || '',
                lead: row.lead || '',
                shortText: row.lead || '',
                excerpt: row.lead || row.excerpt || '',
                body: row.body || '',
                fullText: row.body || '',
                author: row.author_name || row.author || 'Редакция LSN',
                author_id: row.author_id,
                img: safeImageUrl(row.image_url),
                customImg: safeImageUrl(row.image_url),
                archivedAt: row.updated_at || row.created_at || new Date().toISOString()
              });
            }
          });
        }
      } catch (err) {
        console.warn('Archive cloud fetch error:', err);
      }
    }

    saveLocalArchive(items);
    if (counterEl) {
      counterEl.textContent = items.length + ' в архиве';
    }

    const filtered = archiveFilter === 'all'
      ? items
      : items.filter(x => (x.actType || 'news') === archiveFilter);

    if (filtered.length === 0) {
      listEl.innerHTML = '<div style="padding:40px 20px; text-align:center; color:#64748b; background:rgba(15,23,42,0.4); border-radius:12px; border:1px dashed rgba(255,255,255,0.08);">' +
