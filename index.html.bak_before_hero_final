/* Night Neon Mode for Skyline Panorama */
.v6-skyline[data-sky-theme="night"] .gta-sky-svg {
  filter: hue-rotate(-28deg) saturate(1.32) brightness(0.92) contrast(1.08);
}
.v6-skyline .gta-sky-svg {
  transition: filter 0.55s ease;
}

/* 6. Ad Carousel SVG Art & Navigation Controls */
.lsn-ad-svg {
  width: 100%;
