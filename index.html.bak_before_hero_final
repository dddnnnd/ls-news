          : isArchived
          ? `<div class="cab-status-pill status-archived" style="display:inline-block; padding:2px 8px; border-radius:4px; font-weight:700; font-size:10.5px; color:#94a3b8; background:rgba(148,163,184,0.12); border:1px solid rgba(148,163,184,0.25); margin-bottom:4px;">● В АРХИВЕ</div>`
          : `<div class="cab-status-pill status-published" style="display:inline-block; padding:2px 8px; border-radius:4px; font-weight:700; font-size:10.5px; color:#F28C28; background:rgba(242,140,40,0.12); border:1px solid rgba(242,140,40,0.25); margin-bottom:4px;">● ОПУБЛИКОВАНО</div>`;
        if (isArchived) {
          bumpHtml = `<button type="button" class="cab-ad-mini-btn" data-uni-unarchive="${item.id}" style="color:#F28C28; border-color:rgba(242,140,40,0.35);">Из архива</button>`;
        } else {
          bumpHtml = `<button type="button" class="cab-ad-mini-btn" data-uni-quickarchive="${item.id}" style="color:#94a3b8;">В архив</button>`;
        }
      } else {
        const isDraft = item.status === 'draft' || item.isDraft;
        statusHtml = isDraft
          ? `<div class="cab-ad-item__tag" style="color:#fbbf24;">● ЧЕРНОВИК</div>`
          : `<div class="cab-ad-item__tag" style="color:#10b981;">● ОПУБЛИКОВАНО</div>`;
