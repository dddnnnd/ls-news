    if (!bytes) return 'Готово';
    if (bytes < 1024 * 1024) return `${Math.max(1, Math.round(bytes / 1024))} КБ`;
    return `${(bytes / 1024 / 1024).toFixed(1)} МБ`;
  };

  const updateMediaUI = () => {
    const hasImage = !!currentPhotoData;
    if (mediaStatusEl) {
      mediaStatusEl.textContent = hasImage ? 'Изображение выбрано' : 'Изображение не выбрано';
      mediaStatusEl.classList.toggle('is-ready', hasImage);
    }
    if (mediaSelectedEl) mediaSelectedEl.hidden = !hasImage;
    if (mediaSelectedNameEl) mediaSelectedNameEl.textContent = currentPhotoMeta.name || (hasImage ? 'Иллюстрация LSN' : 'Изображение');
    if (mediaSelectedMetaEl) mediaSelectedMetaEl.textContent = currentPhotoMeta.width ? `${currentPhotoMeta.width}×${currentPhotoMeta.height} · ${formatBytes(currentPhotoMeta.size)}` : 'Готово к сохранению';
    if (previewSizeEl) previewSizeEl.textContent = currentPhotoMeta.width ? `${currentPhotoMeta.width}×${currentPhotoMeta.height}` : '';
  };

  const setCurrentPhoto = (data, meta = {}) => {
    currentPhotoData = data || '';
    currentPhotoMeta = { name: meta.name || '', size: meta.size || 0, width: meta.width || 0, height: meta.height || 0 };
    renderQuickArtChips();
    updateMediaUI();
    if (albumWrapEl && !albumWrapEl.hidden) renderSiteAlbumGrid();
  };

  const renderSiteAlbumGrid = () => {
    if (!albumGridEl) return;
    const q = (albumSearchEl?.value || '').trim().toLowerCase();
    const filtered = LSN_SITE_ALBUM.filter(ill => !q || `${ill.title} ${ill.tag}`.toLowerCase().includes(q));
    if (albumCountEl) albumCountEl.textContent = `${filtered.length} ${filtered.length === 1 ? 'иллюстрация' : 'иллюстраций'}`;
    albumGridEl.innerHTML = '';
    filtered.forEach((ill) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'uni-album-card' + (currentPhotoData === ill.src ? ' is-selected' : '');
      btn.innerHTML = `<span class="uni-album-card__tag">${escapeHtml(ill.tag)}</span><img class="uni-album-card__img" src="${ill.src}" alt="${escapeHtml(ill.title)}" loading="lazy"><span class="uni-album-card__title">${escapeHtml(ill.title)}</span>`;
      btn.addEventListener('click', () => {
        if (!canUserModifyCurrentImage()) {
          flashUniSaved('🔒 У этой роли нет права изменять изображение для этого материала.');
          return;
        }
        setCurrentPhoto(ill.src, { name: ill.title, size: 0, width: 800, height: 500 });
        const fileInput = $('#uni-field-file'); if (fileInput) fileInput.value = '';
        flashUniSaved(`✓ Выбрано: ${ill.title}`);
      });
      albumGridEl.appendChild(btn);
    });
    if (!filtered.length) albumGridEl.innerHTML = '<div style="grid-column:1/-1;padding:24px;text-align:center;color:#7f90a3;font-size:11px;">Ничего не найдено. Попробуйте другой запрос.</div>';
  };

  const handleMediaFile = async (file) => {
    try {
      const result = await compressUploadedImage(file, 1280, 800);
      let finalImageUrl = result.data;
      // Attempt cloud upload to Supabase Storage bucket `article-images` when session is active
      if (sb && currentUser?.uuid) {
        try {
          const { data: sessionData } = await sb.auth.getSession();
          const uid = sessionData?.session?.user?.id;
          if (uid && result.data.startsWith('data:image/')) {
            const res = await fetch(result.data);
            const blob = await res.blob();
            const ext = blob.type === 'image/png' ? 'png' : 'jpg';
            const storagePath = `${uid}/lsn_${Date.now()}_${Math.random().toString(36).slice(2, 8)}.${ext}`;
            const { error: upErr } = await sb.storage.from('article-images').upload(storagePath, blob, {
              contentType: blob.type,
              upsert: true
            });
            if (!upErr) {
              const { data: pubData } = sb.storage.from('article-images').getPublicUrl(storagePath);
              if (pubData?.publicUrl) {
                finalImageUrl = pubData.publicUrl;
              }
            }
          }
        } catch (storageErr) {
          console.warn('Supabase Storage upload fallback to inline data URL:', storageErr);
        }
      }
      setCurrentPhoto(finalImageUrl, result);
      flashUniSaved('✓ Изображение загружено и оптимизировано');
    } catch (err) {
      setCurrentPhoto('', {});
      const msg = err?.message || 'Не удалось загрузить изображение.';
      flashUniSaved(`⚠️ ${msg}`);
    }
  };

  toggleAlbumBtn?.addEventListener('click', () => {
    if (!albumWrapEl) return;
    albumWrapEl.hidden = !albumWrapEl.hidden;
    if (!albumWrapEl.hidden) { renderSiteAlbumGrid(); albumSearchEl?.focus(); }
  });
  closeAlbumBtn?.addEventListener('click', () => { if (albumWrapEl) albumWrapEl.hidden = true; });
  albumSearchEl?.addEventListener('input', renderSiteAlbumGrid);

  dropzoneEl?.addEventListener('click', () => {
    if (!canUserModifyCurrentImage()) {
      flashUniSaved('🔒 У этой роли нет права изменять изображение для этого материала.');
      return;
    }
    $('#uni-field-file')?.click();
  });
  dropzoneEl?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      if (!canUserModifyCurrentImage()) {
        flashUniSaved('🔒 У этой роли нет права изменять изображение для этого материала.');
        return;
      }
      $('#uni-field-file')?.click();
    }
  });
  ['dragenter','dragover'].forEach(evt => dropzoneEl?.addEventListener(evt, e => { e.preventDefault(); dropzoneEl.classList.add('is-dragover'); }));
  ['dragleave','drop'].forEach(evt => dropzoneEl?.addEventListener(evt, e => { e.preventDefault(); dropzoneEl.classList.remove('is-dragover'); }));
  dropzoneEl?.addEventListener('drop', e => {
    e.preventDefault();
    if (!canUserModifyCurrentImage()) {
      flashUniSaved('🔒 У этой роли нет права изменять изображение для этого материала.');
      return;
    }
    const file = e.dataTransfer?.files?.[0];
    if (file) handleMediaFile(file);
  });

  updateMediaUI();

  // =========================================================================
  // FONT STYLE SWITCHER (Exo 2 / Montserrat / Unbounded / Comfortaa)
  // =========================================================================
  const FONT_THEMES = [
    { id: 'exo2', label: 'Aa', name: 'Exo 2' },
    { id: 'wix', label: 'Aa', name: 'Wix Madefor' },
    { id: 'montserrat', label: 'Aa', name: 'Montserrat' },
    { id: 'space', label: 'Aa', name: 'Space Grotesk' },
    { id: 'unbounded', label: 'Aa', name: 'Unbounded' },
    { id: 'play', label: 'Aa', name: 'Play' },
    { id: 'comfortaa', label: 'Aa', name: 'Comfortaa' }
  ];
  let activeFontIdx = 0;
  try {
    const savedFont = localStorage.getItem('lsn_font_theme_v1');
    const foundIdx = FONT_THEMES.findIndex(f => f.id === savedFont);
    if (foundIdx >= 0) activeFontIdx = foundIdx;
  } catch (_) {}

  const applyFontTheme = (idx) => {
    activeFontIdx = (idx + FONT_THEMES.length) % FONT_THEMES.length;
    const theme = FONT_THEMES[activeFontIdx];
    if (theme.id === 'exo2') {
      document.documentElement.removeAttribute('data-font-theme');
    } else {
      document.documentElement.setAttribute('data-font-theme', theme.id);
    }
    const btn = $('#lsn-font-cycle-btn');
    if (btn) btn.title = `Шрифт: ${theme.name}`;
    const lbl = $('#lsn-font-cycle-label');
    if (lbl) lbl.textContent = 'Aa';
    try { localStorage.setItem('lsn_font_theme_v1', theme.id); } catch (_) {}
  };
  applyFontTheme(activeFontIdx);
  $('#lsn-font-cycle-btn')?.addEventListener('click', () => applyFontTheme(activeFontIdx + 1));

  // =========================================================================
  // TOP NAVBAR LINKS: Главное, Новости, Реклама, Трудоустройство
  // =========================================================================
  const highlightNavTarget = (el) => {
    if (!el) return;
    el.classList.remove('is-nav-highlighted');
    void el.offsetWidth;
    el.classList.add('is-nav-highlighted');
  };

  $$('.nav a[data-nav-target]').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      $$('.nav a').forEach(a => a.classList.remove('active'));
      link.classList.add('active');
      const targetKey = link.dataset.navTarget;

      if (targetKey === 'main-news') {
        const sec = $('#news');
        sec?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        highlightNavTarget($('#news-grid') || sec);
      } else if (targetKey === 'latest-news') {
        const sec = $('#latest-news-section') || $('#latest-news');
        sec?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        highlightNavTarget($('#latest-news') || sec);
      } else if (targetKey === 'ad-carousel') {
        const sec = $('#lsn-ad-carousel');
        sec?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        highlightNavTarget(sec);
      } else if (targetKey === 'job-article') {
        const jobCol = columnsState.find(c => /работа|ваканс|трудоу|штат|стажер/i.test((c.title || '') + ' ' + (c.subtitle || ''))) || columnsState[0];
        const cardEl = $('#job-article-card') || $('#columns-articles-section');
        cardEl?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        highlightNavTarget(cardEl);
        if (jobCol) {
          setTimeout(() => {
            openUniversalReaderModal({
              type: 'column',
              id: jobCol.id,
              category: jobCol.subtitle || 'Карьера в редакции 102.2 FM',
              title: jobCol.title,
              author: 'Редакция Los Santos News • 102.2 FM',
              dateText: 'Офис Commerce • 102.2 FM',
              body: jobCol.body,
              img: jobCol.img,
              titleColor: jobCol.titleColor || ''
            });
          }, 420);
        }
      }
    });
  });

  // Initial UI Boot Renders
  renderHeroFocusSection();
  syncRoleVisibilityUI();
  renderNewsSections();
  renderAdsCarousel();
  renderEditorialColumns();
  renderStaffSection();

  // ==========================================
  // V13 EDITORIAL BACKUP & RESTORE SUITE (JSON)
  // ==========================================
  const EDITORIAL_BOOTSTRAP_LOCAL_KEY = 'lsn_cloud_editorial_initialized_v1';
  const isUuidValue = (value) => /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(String(value || ''));

  const STAFF_UUID_MAP = {
    'staff-1': '7a2d1001-4455-4000-8000-000000000001',
    'staff-former-director': '7a2d1008-4455-4000-8000-000000000008',
    'staff-2': '7a2d1002-4455-4000-8000-000000000002',
    'staff-3': '7a2d1003-4455-4000-8000-000000000003',
    'staff-4': '7a2d1004-4455-4000-8000-000000000004',
    'staff-5': '7a2d1005-4455-4000-8000-000000000005',
    'staff-6': '7a2d1006-4455-4000-8000-000000000006',
    'staff-7': '7a2d1007-4455-4000-8000-000000000007',
    'staff-intro': '7a2d1000-4455-4000-8000-000000000000',
    'hero-focus': '7a2d1000-4455-4000-8000-000000000099'
  };

  const readEditorialInitialized = async () => {
    if (sb) {
      try {
        const { data, error } = await sb.from('lsn_editorial_state').select('initialized').eq('id', true).maybeSingle();
        if (!error && data !== null && typeof data === 'object') {
          return !!data.initialized;
        }
        if (error) {
          console.warn('lsn_editorial_state query warning:', error.message);
          return null;
        }
      } catch (err) {
        console.warn('lsn_editorial_state network error:', err);
        return null;
      }
    }
    try { return localStorage.getItem(EDITORIAL_BOOTSTRAP_LOCAL_KEY) === 'true'; } catch (_) { return false; }
  };

  const markEditorialInitialized = async () => {
    let serverMarked = false;
    if (sb && currentUser && getUserRoleInfo(currentUser).rank >= 3) {
      try {
        const { data, error } = await sb.rpc('lsn_mark_editorial_state_initialized');
        serverMarked = !error && data === true;
        if (serverMarked) {
          try { localStorage.setItem(EDITORIAL_BOOTSTRAP_LOCAL_KEY, 'true'); } catch (_) {}
        } else if (error) {
          console.warn('Editorial migration marker RPC is unavailable:', error.message);
        }
      } catch (e) { console.warn('Editorial marker was not written to Supabase:', e); }
    } else if (!sb) {
      try { localStorage.setItem(EDITORIAL_BOOTSTRAP_LOCAL_KEY, 'true'); } catch (_) {}
      serverMarked = true;
    }
    return serverMarked;
  };

  const getStableUuidForLocalId = (oldId) => {
    if (isUuidValue(oldId)) return oldId;
    if (STAFF_UUID_MAP && STAFF_UUID_MAP[oldId]) return STAFF_UUID_MAP[oldId];
    let stableMap = {};
    try { stableMap = JSON.parse(localStorage.getItem('lsn_stable_uuid_map') || '{}'); } catch (_) {}
    if (stableMap[oldId]) return stableMap[oldId];
    const newUuid = createArticleUuid();
    stableMap[oldId] = newUuid;
    try { localStorage.setItem('lsn_stable_uuid_map', JSON.stringify(stableMap)); } catch (_) {}
    return newUuid;
  };

  const mapLocalItemToCloudRow = (type, item, allowDeleted = false) => {
    if (!item || (!allowDeleted && isItemDeleted(item.id))) return null;
    const title = String(item.title || item.name || '').trim();
    if (!title) return null;
    const oldId = String(item.id || '');
    const id = getStableUuidForLocalId(oldId);
    item.id = id;
    const authorId = currentUser?.uuid || null;
    const authorName = item.author || item.author_name || currentUser?.fullName || currentUser?.nickname || 'Редакция LSN';
    const category = type === 'ad' ? (item.tag || item.category || 'Реклама')
      : type === 'column' ? (item.subtitle || item.category || 'Колонка')
      : type === 'staff' ? (item.role || 'Сотрудник LSN')
      : (item.category || 'Новости');
    const body = String(item.body || item.fullText || item.bio || '');
    const image = safeImageUrl(item.img || item.customImg || item.image_url || '');
    const status = type === 'news' ? (item.status === 'draft' ? 'draft' : 'published') : 'published';
    return {
      id, type, title: title.slice(0, 140), category, body,
      excerpt: String(item.excerpt || item.shortText || item.role || makeShortPreview(body, 160)).slice(0, 240),
      lead: String(item.lead || item.excerpt || item.shortText || item.role || makeShortPreview(body, 160)).slice(0, 240),
      author_name: String(authorName).slice(0, 100), author_id: authorId,
      image_url: image, status, updated_at: new Date().toISOString(),
      metadata: {
        accent: item.accent || 'amber',
        titleColor: item.titleColor || '',
        skinId: item.skinId || '',
        badge: item.badge || ''
      }
    };
  };

  const autoBootstrapEditorialToCloud = async () => {
    if (!sb) return false;
    // Strict authentication and management check: visitors/anon must never bootstrap
    const { data: sessionData } = await sb.auth.getSession();
    if (!sessionData?.session?.user) return false;
    const callerRole = getUserRoleInfo(currentUser);
    if (!callerRole || callerRole.rank < 3) {
      console.warn('Auto-bootstrap restricted: management privileges required.');
      return false;
    }
    // Emergency local backup before cloud seeding
    try {
      localStorage.setItem('lsn_pre_bootstrap_backup', JSON.stringify({
        news: newsState,
        ads: adsState,
        columns: columnsState,
        staff: staffState,
        savedAt: new Date().toISOString()
      }));
    } catch (_) {}
    try {
      const rows = [];
      if (!isSectionCleared('ad')) {
        const adsToSeed = (adsState && adsState.length > 0) ? adsState : DEFAULT_ADS_DATA;
        adsToSeed.forEach(a => {
          if (!isItemDeleted(a.id)) {
            const row = mapLocalItemToCloudRow('ad', a);
            if (row) rows.push(row);
          }
        });
      }
      if (!isSectionCleared('column')) {
        const colsToSeed = (columnsState && columnsState.length > 0) ? columnsState : DEFAULT_COLUMNS_DATA;
        colsToSeed.forEach(c => {
          if (!isItemDeleted(c.id)) {
            const row = mapLocalItemToCloudRow('column', c);
            if (row) rows.push(row);
          }
        });
      }
      if (!isSectionCleared('news') && newsState && newsState.length > 0) {
        newsState.forEach(n => {
          if (!isItemDeleted(n.id)) {
            const row = mapLocalItemToCloudRow('news', n);
            if (row) rows.push(row);
          }
        });
      }
      if (staffState && Array.isArray(staffState.members)) {
        staffState.members.forEach(m => {
          if (!isItemDeleted(m.id)) {
            const row = mapLocalItemToCloudRow('staff', m);
            if (row) rows.push(row);
          }
        });
      }

      if (rows.length > 0) {
        const { error } = await sb.from('lsn_articles').upsert(rows, { onConflict: 'id' });
        if (error) {
          console.warn('Auto-bootstrap editorial content note:', error.message);
          return false;
        }
        console.log(`LSN: Successfully seeded ${rows.length} articles to Supabase cloud.`);
      }
      await markEditorialInitialized();
      return true;
    } catch (err) {
      console.warn('Auto-bootstrap editorial error:', err);
      return false;
    }
  };

  const LSN_BACKUP_SCHEMA = 'lsn-editorial-backup-v1';
  const downloadEditorialBackup = () => {
    const payload = {
      schema: LSN_BACKUP_SCHEMA,
      exportedAt: new Date().toISOString(),
      content: {
        news: newsState,
        ads: adsState,
        columns: columnsState,
        staff: staffState,
        deletedIds: getDeletedIds(),
        cleared: ['news','ad','column'].reduce((acc, type) => { acc[type] = isSectionCleared(type); return acc; }, {})
      }
    };
    const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `lsn-content-backup-${new Date().toISOString().slice(0, 10)}.json`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
    flashUniSaved('Резервная копия скачана');
  };

  const validateBackupArray = (value, max, label) => {
    if (!Array.isArray(value) || value.length > max) throw new Error(`Некорректный раздел «${label}»`);
    const validIdRegex = /^[a-zA-Z0-9_\-]+$/;
    for (const item of value) {
      if (!item || typeof item !== 'object' || typeof item.id !== 'string' || typeof item.title !== 'string') {
        throw new Error(`В резервной копии повреждён раздел «${label}»`);
      }
      const cleanId = String(item.id).trim();
      if (!cleanId || cleanId.length > 64 || !validIdRegex.test(cleanId)) {
        throw new Error(`Недопустимый идентификатор материала в разделе «${label}»`);
      }
      if (item.title.length > 160 || String(item.body || item.fullText || '').length > 20000) {
        throw new Error(`Слишком большой материал в разделе «${label}»`);
      }
      const imgLen = String(item.img || item.customImg || item.image_url || '').length;
      if (imgLen > 5000000) {
        throw new Error(`Превышен допустимый размер вложения в разделе «${label}»`);
      }
    }
    return value;
  };

  const restoreEditorialBackup = async (file) => {
    if (!file || file.size > 12 * 1024 * 1024) throw new Error('Файл резервной копии должен быть меньше 12 МБ');
    const backup = JSON.parse(await file.text());
    if (!backup || backup.schema !== LSN_BACKUP_SCHEMA || !backup.content) throw new Error('Файл не является резервной копией Los Santos News');
    const role = getUserRoleInfo(currentUser);
    if (role.level !== 'admin') throw new Error('Восстанавливать контент может только администратор');
    const content = backup.content;
    const incomingNews = validateBackupArray(content.news || [], 500, 'Новости');
    const incomingAds = validateBackupArray(content.ads || [], 250, 'Реклама');
    const incomingColumns = validateBackupArray(content.columns || [], 250, 'Колонки');
    if (!content.staff || typeof content.staff !== 'object' || !Array.isArray(content.staff.members)) {
      throw new Error('Некорректный состав редакции');
    }
    const validIdRegex = /^[a-zA-Z0-9_\-]+$/;
    for (const m of content.staff.members) {
      if (!m || typeof m !== 'object' || !m.id || !validIdRegex.test(String(m.id)) || !m.name) {
        throw new Error('Повреждены данные сотрудника в составе редакции');
      }
      if (String(m.img || m.customImg || '').length > 5000000) {
        throw new Error('Превышен размер фотографии сотрудника в составе редакции');
      }
    }

    const explicitRestoreIds = new Set([...incomingNews, ...incomingAds, ...incomingColumns].map(item => String(item.id)));
    const merge = (current, incoming) => {
      const map = new Map((current || []).filter(x => x && x.id && !explicitRestoreIds.has(String(x.id)) && !isItemDeleted(x.id)).map(x => [String(x.id), x]));
      incoming.forEach(item => { if (item && item.id) map.set(String(item.id), item); });
      return Array.from(map.values()).filter(x => x && x.id);
    };

    const targetNews = merge(newsState, incomingNews);
    const targetAds = merge(adsState, incomingAds);
    const targetColumns = merge(columnsState, incomingColumns);
    const targetStaff = content.staff;

    // Cloud upsert FIRST before local storage commit
    if (sb) {
      const rows = [];
      const addRestored = (type, list) => (list || []).forEach(item => {
        const row = mapLocalItemToCloudRow(type, item);
        if (row) rows.push(row);
      });
      addRestored('news', targetNews);
      addRestored('ad', targetAds);
      addRestored('column', targetColumns);
      if (targetStaff && Array.isArray(targetStaff.members)) {
        addRestored('staff', targetStaff.members);
      }
      if (rows.length) {
        const { error } = await sb.from('lsn_articles').upsert(rows, { onConflict: 'id' });
        if (error) {
          console.error('Supabase backup restore sync error:', error);
          throw new Error('Ошибка сохранения резервной копии в Supabase: ' + error.message);
        }
      }
      await markEditorialInitialized();
    }

    // Safely commit to local storage after verified cloud upsert or in standalone mode
    try {
      localStorage.setItem(DELETED_ITEMS_KEY, JSON.stringify(getDeletedIds().filter(id => !explicitRestoreIds.has(String(id)))));
    } catch (_) {}
    newsState = targetNews;
    adsState = targetAds;
    columnsState = targetColumns;
    staffState = targetStaff;
    if (Array.isArray(content.deletedIds)) {
      try {
        const keep = new Set(getDeletedIds());
        content.deletedIds.slice(0, 2000).forEach(id => { if (typeof id === 'string' && !explicitRestoreIds.has(id)) keep.add(id); });
        localStorage.setItem(DELETED_ITEMS_KEY, JSON.stringify(Array.from(keep)));
      } catch (_) {}
    }
    if (content.cleared && typeof content.cleared === 'object') {
      ['news', 'ad', 'column'].forEach(type => {
        if (content.cleared[type] === true) markSectionCleared(type, true);
        else markSectionCleared(type, false);
      });
    }
    saveNewsState(); saveAdsState(); saveColumnsState(); saveStaffState();
    renderNewsSections(); renderAdsCarousel(); renderEditorialColumns(); renderStaffSection();

    if (sb) {
      flashUniSaved('✅ Контент успешно восстановлен из резервной копии и синхронизирован с облаком');
    } else {
